<Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" /><appSettings>
        <add key="app_mail_address" value="$app_mail_address_value" />
        <add key="app_mail_id" value="$app_mail_id_value" />
    </appSettings><Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="$resourcePath_Value" enableWatching="1" />
        </providers>
    </Fanex.Data.DbSettingProvider><NapSettings Environment="UAT" EnableDirectLogin="1" SiteId="67" UnauthorizeUrl="~/Home/NonePermission" EnableReCheckin="false" HubUrl="http://localhost:54332/NAPHub" ServiceUrls="http://10.18.200.124:1710/api" AccessKey="zU1yEh4KD+zzNkake1nWcXhgxrmMFihRLszarWBDJuw=">
    <Domain>
      <add Name="10.18.200.209:7123" Path="/" />
    </Domain>
  </NapSettings><Fanex.Caching cacheType="Fanex.Caching.Memory.MemoryCache, Fanex.Caching">
        <connectionSettings>
            <add name="CompactOnMemoryPressure" value="true" />
            <add name="ExpirationScanFrequency" value="1" />
        </connectionSettings>
    </Fanex.Caching><startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" /></startup></configuration>
