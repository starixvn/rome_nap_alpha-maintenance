@using Fanex.Maintenance.Core.Model
@model Machine
@{
    ViewBag.Title = ViewResource.InsertMachine;
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool success = ((ViewBag.Success != null) && (ViewBag.Success.Code == 0));  
}
@section Head {
    @Styles.Render("~/css/manage")
}
@section Headline {
    <h1>
        <span class="title">@ViewResource.InsertMachine</span>
        @Html.ActionLink("← " + ViewResource.Back_To_List, "Index", "Machine", null, new { @class = "lnk" })
    </h1>
}
@using (Html.BeginForm())
{
    <div class="form">
        <div class="form-row summary">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @Html.ValidationSummary()
                @Html.HiddenFor(m => m.MachineId)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.MachineName, ViewResource.Machine_Name)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.MachineName)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.MachineIP, ViewResource.Machine_IP)
            </div>
            <div class="edit-field">
                @Html.EditorFor(m => m.MachineIP)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.IsProduction, ViewResource.IsProduction)
            </div>
            <div class="edit-field">
                @Html.EditorFor(m => m.IsProduction)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.TimeZone, ViewResource.TimeZone)
            </div>
            <div class="edit-field">
                @Html.EditorFor(m => m.TimeZone)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @if (!success)
                {
                    <input type="submit" value="@ViewResource.Save" />
                    <input type="reset" value="@ViewResource.Cancel" />  
                }
            </div>
        </div>
    </div>
}
@section Foot
{
    <script type="text/javascript">
        $(function () {
            $('input[type=reset]').bind('click', function () {
                window.location.replace(NAP.resolveClientUrl('Machine'));
            });
        });
    </script>
    @if (success)
    {
        string dialogMsg = string.Format(ViewResource.AddSuccessMsg, ViewResource.Machine + " '" + Model.MachineName, 5);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'Machine', 6000);
            });

        </script>
    }
}
