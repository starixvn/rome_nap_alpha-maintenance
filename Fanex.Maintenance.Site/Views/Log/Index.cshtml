@using Fanex.Maintenance.Repository.Criteria.Log
@using Fanex.Maintenance.Core.Model
@model GetLogCriteria
@{
    ViewBag.Title = ViewResource.AppLogs_ViewLog;
    Layout = "~/Views/Shared/_Layout.cshtml";
    IEnumerable<Log> listLog = (IEnumerable<Log>)ViewBag.ListLog;    
}
@section Head {
    @Styles.Render("~/css/log")
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
        @if (Model.HasEdit)
        {
            <a href="#" id="btnRemoveLog" class="lnk">Remove (Before date @DateTime.Now.AddDays(-5).ToShortDateString())
            </a>
        }
    </h1>
}
@using (Html.BeginForm())
{  
    <section id="filter-bar" style="width: 98%" ng-controller="logController">
        <div class="filter-form">
            <div class="filter-row">
                <div class="lbl-field width-60">
                    @Html.LabelFor(m => m.CategoryId, ViewResource.Category)
                </div>
                <div class="edit-field width-220">
                    @Html.DropDownListFor(m => m.CategoryId, (List<SelectListItem>)ViewBag.ListCategory, new { @class = "width-220" })
                </div>
                <div class="lbl-field width-60">
                    @Html.LabelFor(m => m.From, ViewResource.From)
                </div>
                <div class="edit-field width-120">
                    @Html.TextBox("From", Model.From.ToString("MMM dd,yyyy"), new { @style = "width:77px;margin-right:5px;", @autocomplete = "off" })
                </div>
                <div class="lbl-field width-40">
                    @Html.LabelFor(m => m.To, ViewResource.To)
                </div>
                <div class="edit-field width-120">
                    @Html.TextBox("To", Model.To.ToString("MMM dd,yyyy"), new { @style = "width:77px;margin-right:5px;", @autocomplete = "off" })
                </div>
                <div class="lbl-field width-70">
                    @Html.LabelFor(m => m.ToGMT, ViewResource.TimeZone)
                </div>
                <div class="edit-field width-120">
                    @Html.DropDownListFor(m => m.ToGMT, (List<SelectListItem>)ViewBag.ListTimeZone, new { @class = "width-80" })
                </div>
            </div>
            <div class="filter-row">
                <div class="lbl-field width-60">
                    @Html.LabelFor(m => m.MachineId, ViewResource.Machine)
                </div>
                <div class="edit-field width-220">
                    <select id="MachineId" name="MachineId" class="width-220">
                    </select>
                </div>
                <div class="lbl-field width-60">
                    @Html.LabelFor(m => m.Severity, ViewResource.Severity)
                </div>
                <div class="edit-field width-120">
                    @Html.DropDownListFor(m => m.Severity, (List<SelectListItem>)ViewBag.ListSeverity, new { @class = "width-100" })
                </div>
                <div class="lbl-field width-40">
                    @Html.LabelFor(m => m.IsMonitored, ViewResource.Status)
                </div>
                <div class="edit-field width-120">
                    @Html.DropDownListFor(m => m.IsMonitored, (List<SelectListItem>)ViewBag.LogStatus, new { @class = "width-100" })
                </div>
                <div class="submit">
                    <input type="button" value="@ViewResource.Submit" id="submit" />
                </div>
            </div>
        </div>
    </section>
    @Html.HiddenFor(m => m.Page)   
    <div id="pagination">
    </div>     
    <table class="grid persist-area">
        <thead class="persist-header">
            <tr>
                <th>
                    #
                </th>
                <th>
                    Message
                </th>
                <th class="width-120">
                    Category
                </th>
                <th>
                    Severity
                </th>
                <th class="width-180">
                    Machine
                </th>
                <th class="width-100">
                    @if (Model.HasEdit)
                    { 
                        <input type="checkbox" id="chbMonitorAll" />
                    }
                    <lable for="chbMonitorAll">Handled By</lable>
                </th>
                <th class="width-100">
                    <span id="timeZone">Time (GMT @(Model.ToGMT > 0 ? "+" + Model.ToGMT.ToString() : Model.ToGMT.ToString()))</span>
                </th>
            </tr>
        </thead>
        <tbody id="content">
        </tbody>
    </table>
}
@Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
@Html.Hidden("HasEdit", Model.HasEdit ? 1 : 0)
@section Foot {
    @Scripts.Render("~/scripts/log")
}
