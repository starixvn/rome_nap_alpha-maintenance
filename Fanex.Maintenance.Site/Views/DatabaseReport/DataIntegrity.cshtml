@model DataIntegrityViewModel
@{
    ViewBag.Title = "Data Integrity";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    ViewBag.Title = string.Format("{0}", "Data Integrity");
}
@section Head
{
    @Styles.Render("~/css/database-report")
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
    </h1>
}
<section id="filter-bar">
    <div class="filter-form">
        <div class="lbl-field width-auto">
            @Html.Label(@ViewResource.DrawFilter)
        </div>
        <div class="edit-field">
            @Html.DropDownListFor(m => m.DrawFilter, (List<SelectListItem>)ViewBag.ListDrawFilter)
        </div>
        <div class="lbl-field width-auto">
            @Html.LabelFor(m => m.Date)
        </div>
        <div class="edit-field">
            @Html.TextBoxFor(m => m.Date, (string)ViewBag.MaxDate, new { @style = "width:90px;margin-right:5px;" })
        </div>
        <div class="submit">
            <input type="submit" value="Submit" />
        </div>
    </div>
</section>
<div id="deposit">
</div>
<br />
<br />
<div id="credit">
</div>
<input type="hidden" value="@ViewBag.MinDate" id="minDate" />
<input type="hidden" value="@ViewBag.MaxDate" id="maxDate" />
@section Foot {
    <script type="text/javascript">
        $(function () {
            var buttonFromImage = '@Url.Content("~/images/calendar.gif")';
            $("#Date").datepicker({
                showOn: "button",
                buttonImage: buttonFromImage,
                buttonImageOnly: true,
                dateFormat: "dd/mm/yy",
                maxDate: $('#maxDate').val(),
                defaultDate: $('#maxDate').val()
            });
        });   
        
        $('input[type=submit]').click(function(){

            var countComplete=0;
            
            $.ajax({
                url: NAP.resolveClientUrl("DatabaseReport/GetDepositIntegrity"),
                data: {
                    filter: $('#DrawFilter').val(),
                    date: $('#Date').val(),
                },
                type: 'POST',
                dataType: 'html',
                cache: false,
                beforeSend: function () {
                    NAP.loadingBox.show();
                },
                complete: function () {
                    countComplete++;
                    if(countComplete==2){
                        NAP.loadingBox.close();
                    }
                },
                success: function (result) {
                    $('#deposit').append('<h1><span class="titleSites">Deposit Sites</span></h1>');
                    $('#deposit').append(result);
                },
                error: function (xhr, status, err) {
                    NAP.handleAjaxError(xhr, status, err);
                }
            });
            $.ajax({
                url: NAP.resolveClientUrl("DatabaseReport/GetCreditIntegrity"),
                data: {
                    filter: $('#DrawFilter').val(),
                    date: $('#Date').val(),
                },
                type: 'POST',
                dataType: 'html',
                cache: false,
                beforeSend: function () {
                    NAP.loadingBox.show();
                },
                complete: function () {
                    countComplete++;
                    if(countComplete==2){
                        NAP.loadingBox.close();
                    }
                },
                success: function (result) {
                    $('#credit').append('<h1><span class="titleSites">Credit Sites</span></h1>');
                    $('#credit').append(result);
                },
                error: function (xhr, status, err) {
                    NAP.handleAjaxError(xhr, status, err);
                }
            });
        });
    </script>
}
