@model MailSettingViewModel
@{
    ViewBag.Title = ViewResource.Mail_Setting;
    Layout = "~/Views/Shared/_Layout.cshtml";    
}
@{
    ViewBag.Title = string.Format("{0} {1}", ViewResource.Update, ViewResource.Mail_Setting);
    bool success = ViewBag.Success != null && ViewBag.Success;    
}
@section Head {
    @Styles.Render("~/css/manage")
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
        @Html.ActionLink("← " + ViewResource.Back_To_List, "MailSetting", "Mail", null, new { @class = "lnk" })
    </h1>
}
@using (Html.BeginForm())
{
    <div class="form">
        <div class="form-row summary">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @Html.ValidationSummary()
                @Html.HiddenFor(m => m.SettingId)
                @Html.HiddenFor(m => m.SettingName)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Server)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Server)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Port)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Port)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Username)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Username)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Password)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Password)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.IsAuth)
            </div>
            <div class="edit-field">
                @Html.CheckBoxFor(m => m.IsAuth)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @if (!success)
                {
                    <input type="submit" value="@ViewResource.Save" />
                    <input type="reset" value="@ViewResource.Cancel" />  
                }
            </div>
        </div>
    </div>
}
@section Foot
{
    <script type="text/javascript">
        $(function () {
            $('input[type=reset]').bind('click', function () {
                window.location.replace(NAP.resolveClientUrl('Mail/MailSetting'));
            });
        });
    </script>
    @if (success)
    {
        string dialogMsg = string.Format(ViewResource.AddSuccessMsg, ViewResource.Mail_Setting + " '" + Model.SettingName, 5);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'Mail/MailSetting', 6000);
            });

        </script>
    }
}
