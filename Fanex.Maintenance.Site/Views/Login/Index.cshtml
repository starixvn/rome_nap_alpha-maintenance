@using Fanex.Maintenance.Criteria.User
@*@model UserLoginCriteria*@
@{
    Layout = null;
    var success = ViewBag.Success != null ? ViewBag.Success : false;
}
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Maintenance site</title>
    <link href="~/themes/Authentication/login_skin.css" rel="stylesheet" type="text/css" />
    <script src="~/scripts/lib/jquery-1.8.0.min.js" type="text/javascript"></script>
    <script type="text/javascript">
        if (top.frames.length > 1) top.location.href = location.href;
    </script>
</head>
<body>
    <div id="header">
        <div id="logo">
        </div>
    </div>
    <div id="mainLogin">
        <div class="lgRp">
            <div class="war_box">
                @Html.ValidationSummary()
                @ViewBag.Message
            </div>
            @using (Html.BeginForm())
            {
                <div class="form_log">
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td width="29" height="50" class="icUser">
                                &nbsp;
                            </td>
                            <td width="101">
                                <span class="log_text">@ViewResource.Username</span>
                            </td>
                            <td width="220">
                                @Html.TextBox("username")
                            </td>
                        </tr>
                        <tr>
                            <td height="40" class="icPass">
                                &nbsp;
                            </td>
                            <td>
                                <span class="log_text">@ViewResource.Password</span>
                            </td>
                            <td>
                                @Html.Password("password")
                            </td>
                        </tr>
                        <tr>
                            <td height="40">
                                &nbsp;
                            </td>
                            <td>
                                &nbsp;
                            </td>
                            <td>
                                <input type="submit" class="btLg"  value="@ViewResource.Login" style="border:0px"/>
                            </td>
                        </tr>
                    </table>
                </div>
            }
            @if (success)
            {
                <script type="text/javascript">
                    $(function () {
                        window.location.replace(NAP.resolveClientUrl('Home'));
                    });
                </script>
            }
        </div>
    </div>
</body>
</html>
