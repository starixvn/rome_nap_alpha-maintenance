<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en" class="linen" ng-app="app">
<!--<![endif]-->
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>@ViewBag.Title</title>
    <meta http-equiv="cleartype" content="on" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    @Styles.Render("~/css/common")
    @RenderSection("Head", false)
    <style type="text/css">
        #clock
        {
            float: right;
            font-size: large;
            text-align: center;
            color: #6D8DC9;
            padding-right: 50px;
        }
    </style>
</head>
<body>
    <header>
        <div class="logo">
            <a href="~/?ref=logo">mSite</a>
        </div>
        @Html.Action("_Menu", new RouteValueDictionary(new { controller = "Home", area = "" }))
        <div class="user-info">
            <div class="greeting">
                <h2>
                    Howdy, @HttpContext.Current.User.Identity.Name</h2>
                <ul>
                    <li>@Html.ActionLink("Sign Out", "LogOut", "Login", new { Area = "UserLogin" }, new { })</li>
                </ul>
            </div>
        </div>
    </header>
    <section id="headline">
        
        @RenderSection("Headline", false)
        <div id="clock">
            <div id="date"></div>
            <div id="time"></div>
        </div>
    </section>
    @RenderSection("FilterBar", false)
    <section id="body">
        <div class="content">
            @RenderSection("LeftMenu", false)
            @RenderBody()
        </div>
    </section>
    <div id="dialog-message">
    </div>
    <div id="dialog-popup">
    </div>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
    </script>
</body>
</html>
@Html.Hidden("NapAdminRoot", Url.Content("~/"))
@Scripts.Render("~/scripts/common")
@if (ViewBag.ViewFlags != null && ViewBag.ViewFlags.IsReCheckin)
{
    @Scripts.Render("~/scripts/recheckin")
}
@RenderSection("Foot", false)
@RenderSection("scripts", false)
<script type="text/javascript">
    var serverTimeZone = '@ViewBag.TimeZoneString';
    $(document).ready(function () {

        //TIMER
        window.onload = function () { date(), time() }, setInterval(function () { time(); }, 1000);

        function date() {
            var months = new Array(12);
            months[0] = "January";
            months[1] = "February";
            months[2] = "March";
            months[3] = "April";
            months[4] = "May";
            months[5] = "June";
            months[6] = "July";
            months[7] = "August";
            months[8] = "September";
            months[9] = "October";
            months[10] = "November";
            months[11] = "December";

            var day = new Array(7);
            day[0] = "Sunday";
            day[1] = "Monday";
            day[2] = "Tuesday";
            day[3] = "Wednesday";
            day[4] = "Thursday";
            day[5] = "Friday";
            day[6] = "Saturday";

            var date = moment(new Date).zone(serverTimeZone);
            var month_value = date.month();
            var day_value = date.day();
            var daydate = date.date();

            if (daydate < 10) daydate = "0" + daydate;

            //date = day[day_value] + ",&nbsp;" + daydate + "&nbsp;" + months[month_value];

            $('#date').html(date.format('dddd, MMMM DD, YYYY'));
        }

        function time() {
            var time = moment(new Date()).zone(serverTimeZone);
            var hours = time.hours();
            var minutes = time.minutes();
            var seconds = time.seconds();

            if (hours < 10) hours = "0" + hours;
            if (minutes < 10) minutes = "0" + minutes;
            if (seconds < 10) seconds = "0" + seconds;

            //time = hours + ":" + minutes + ":" + seconds;

            $('#date').html(time.format('dddd, MMMM DD, YYYY'));
            $('#time').html(time.format('HH:mm:ss (GT Z)').replace('GT', 'GMT'));
        }

    });
    $.cookie.json = true;
</script>
