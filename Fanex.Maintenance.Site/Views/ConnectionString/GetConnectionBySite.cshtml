@using Fanex.ConnectionString.Domain
@model List<Connection>  
<pre>
&lt;connectionstrings&gt;
@if (!ReferenceEquals(Model, null) && Model.Any())
{
    foreach (var item in Model)
    {
    <span>&lt;add name="@item.Name" connectionString="@item.ConnectionString" providerName="System.Data.SqlClient"/&gt;</span>
    }
}
&lt;connectionStrings&gt; </pre>
