@using Fanex.ConnectionString.Model
@model LogExecSp
@{
    var oldData = Model.ConvertToConnection(Model.OldData);
    var newData = Model.ConvertToConnection(Model.Data);
}
<table style="width: 100%">
    <tr>
        <td>
            #
        </td>
        <td>
            @ViewResource.Old_Value
        </td>
        <td>
            @ViewResource.New_Value
        </td>
    </tr>
    <tr>
        <td>
            @ViewResource.Name
        </td>
        <td>
            @oldData.Name
        </td>
        <td>
            @newData.Name
        </td>
    </tr>
    <tr>
        <td>
            @ViewResource.Status
        </td>
        <td>
            @oldData.IsActive
        </td>
        <td>
            @newData.IsActive
        </td>
    </tr>
</table>
