@using Fanex.ConnectionString.Model
@model LogExecSp
@{
    var oldData = Model.ConvertToListSite(Model.OldData);
    var newData = Model.ConvertToSite(Model.Data);
}
<table style="width: 100%">
    <tr>
        <td>
            @ViewResource.Old_Value @ViewResource.Site
        </td>
    </tr>
    @foreach (var item in oldData)
    {
        <tr>
            <td>@item.Name
            </td>
        </tr>
    }
</table>
<table style="width: 100%">
    <tr>
        <td>
            @ViewResource.New_Value @ViewResource.Site
        </td>
    </tr>
    <tr>
        <td>@newData.Name
        </td>
    </tr>
</table>
