@using Fanex.ConnectionString.Model
@model LogExecSp
@{
    var newData = Model.ConvertToConnection(Model.Data);
}
<table style="width: 100%">
    <tr>
        <td>
            #
        </td>
        <td>
            @ViewResource.Old_Value
        </td>
        <td>
            @ViewResource.New_Value
        </td>
    </tr>
    <tr>
        <td>
            @ViewResource.Name
        </td>
        <td>
            @ViewResource.N_A
        </td>
        <td>
            @newData.Name
        </td>
    </tr>
    <tr>
        <td>
            @ViewResource.DatabaseServer
        </td>
        <td>
            @ViewResource.N_A
        </td>
        <td>
            @newData.DatabaseServer.Name
        </td>
    </tr>
    <tr>
        <td>
            @ViewResource.Database
        </td>
        <td>
            @ViewResource.N_A
        </td>
        <td>
            @newData.Database.Name
        </td>
    </tr>
    <tr>
        <td>
            @ViewResource.LoginName
        </td>
        <td>
            @ViewResource.N_A
        </td>
        <td>
            @newData.LoginName
        </td>
    </tr>
    <tr>
        <td>
            @ViewResource.Password
        </td>
        <td>
            @ViewResource.N_A
        </td>
        <td>
            @newData.Password
        </td>
    </tr>
    <tr>
        <td>
            @ViewResource.Free_Text
        </td>
        <td>
            @ViewResource.N_A
        </td>
        <td>
            @newData.FreeText
        </td>
    </tr>
    <tr>
        <td>
            @ViewResource.Status
        </td>
        <td>
            @ViewResource.N_A
        </td>
        <td>
            @newData.IsActive
        </td>
    </tr>
</table>
