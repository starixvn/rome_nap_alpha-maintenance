@using Fanex.NAP.Core.Helpers
@using Fanex.Maintenance.ViewModel.Connection
@model SearchLogViewModel
@{
    ViewBag.Title = ViewResource.Log_Management;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listLog = Model.LogDatas;
}
@section Head {
    @Styles.Render("~/css/manage")
    <style type="text/css">
        .filter-form .edit-field input[type="datetime"]
        {
            height: 16px;
            width: 80px;
        }
    </style>
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@ViewResource.Log_Management / </span>@ViewResource.Execute_SP_Log</span>
    </h1>
}
<section id="filter-bar">
    @using (Html.BeginForm("Log", "ConnectionString", FormMethod.Get))
    {
        <div class="filter-form">
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.Username)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Username)
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.From)
            </div>
            <div class="edit-field ">
                @Html.EditorFor(m => m.From)
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.To)
            </div>
            <div class="edit-field ">
                @Html.EditorFor(m => m.To)
            </div>
            <div class="lbl-field width-auto divName">
                @Html.LabelFor(m => m.Name)
            </div>
            <div class="edit-field divName">
                @Html.TextBoxFor(m => m.Name)
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.FilterType)
            </div>
            <div class="edit-field">
                @Html.DropDownListFor(m => m.FilterType, new List<SelectListItem>() { new SelectListItem{Text=ViewResource.DatabaseServer,
                Value="1"}, new SelectListItem{Text=ViewResource.Database, Value="2"}, new SelectListItem{Text=ViewResource.Site,
                Value="3"}, new SelectListItem{Text=ViewResource.Connection,Value="4"}})
            </div>
            <div class="submit">
                <input type="submit" value="@ViewResource.Submit" />
            </div>
        </div>    
        @Html.HiddenFor(m => m.PageIndex)   
        @Html.HiddenFor(m => m.PageSize)   
    }
</section>
<table class="grid">
    <thead>
        <tr>
            <th>
                @ViewResource.Log_ID
            </th>
            <th>
                @ViewResource.Log_Date
            </th>
            @switch (Model.FilterType)
            {
                case 1:
                <th>@ViewResource.DatabaseServer
                </th>
               break;
                case 2:
                <th>@ViewResource.Database
                </th>
               break;
                case 3:
                <th>@ViewResource.Site
                </th>
               break;
                case 4:
                <th>@ViewResource.Connection
                </th>
               break;
            }
            <th>
                @ViewResource.Modifier
            </th>
            <th>
                @ViewResource.Action
            </th>
            <th>
                @ViewResource.Description
            </th>
        </tr>
    </thead>
    <tbody>
        @if (!ReferenceEquals(listLog, null) && listLog.Count() > 0)
        {
            int i = 0;
            foreach (var item in listLog)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
		
            <tr @Html.Raw(rowCss)>
                <td>
                    @item.Id
                </td>
                <td style="width: 150px" class="align-center">
                    @item.LogDate.ToFullDateString()
                </td>
                <td style="width: 200px">
                    @item.Name
                </td>
                <td style="width: 100px">
                    @item.Modifier
                </td>
                <td>
                    @item.ActionName
                </td>
                <td class="align-center">
                    @Html.Partial("~/Views/ConnectionString/LogAction/LogAction" + item.ActionId.ToString() + ".cshtml", item)
                </td>
            </tr>
                i++;
            }
        }
        else
        {
            <tr class="no-info">
                <td colspan="12" class="align-center">
                    @ViewResource.NoInformationAvailable
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="12">
                @if (listLog != null && listLog.Count() > 0)
                {
                    <span class="items-per-page-wrp">@ViewResource.Show
                        @Html.DropDownList("items-per-page", new List<SelectListItem>
                        { new SelectListItem { Value = "10", Text = "10", Selected = "10" == Model.PageSize.ToString()
                        }, new SelectListItem { Value = "20", Text = "20", Selected = "20" == Model.PageSize.ToString()
                        }, new SelectListItem { Value = "30", Text = "30", Selected = "30" == Model.PageSize.ToString()
                        } }, new { id = string.Empty, @class = "items-per-page" })</span>

                    @Html.Pager(listLog, new PagerOptions()
               {
                   PageIndexParameterName = "PageIndex",
                   ShowFirstLast
                       = true,
                   CurrentPagerItemWrapperFormatString = "<a class='jp-current'>{0}</a>"
               }, new { @class = "jpages" })
                }
            </td>
        </tr>
    </tfoot>
</table>
@Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
@section Foot {
    <script src="~/scripts/Connection/Log.js" type="text/javascript"></script>
}
