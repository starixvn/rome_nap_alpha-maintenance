@using Fanex.Maintenance.ViewModel.Connection
@model ConnectionAssignSiteViewModel
@{
    ViewBag.Title = ViewResource.Manage_Connection;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var disable = Model.HasEditPermission ? string.Empty : "disabled";
}
@section Head {
    @Styles.Render("~/css/manage")
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title / @Model.Name</span>
        @Html.ActionLink("← " + ViewResource.Back_To_List, "Connection", "ConnectionString", null, new { @class = "lnk" })
    </h1>
}
<table class="grid" style="width: 500px">
    <thead>
        <th>
            #
        </th>
        <th>
            @ViewResource.Site
        </th>
    </thead>
    <tbody>
        @foreach (var item in Model.SelectListSite)
        {
            <tr>
                <td class="align-center">
                    @if (item.Selected)
                    { 
                        <input type="checkbox" sid="@item.Value" class="select-site" checked="checked" name="@item.Text" @disable/>
                    }
                    else
                    { 
                        <input type="checkbox" sid="@item.Value" class="select-site" name="@item.Text" @disable/>
                    }
                </td>
                <td>@item.Text
                </td>
            </tr>
        }
    </tbody>
</table>
@Html.Hidden("ConnectionId", Model.Id)
@section Foot{
    @Scripts.Render("~/scripts/connectionstring-connection")
}
