@using Fanex.Maintenance.ViewModel.Connection
@model SearchSiteViewModel
@{
    ViewBag.Title = ViewResource.Site;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/css/manage")
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
        @if (Model.HasEditPermission)
        { 
            @Html.ActionLink("+ Create New", "CreateSite", "ConnectionString", null, new { @class = "lnk" })
        }
    </h1>
}
@using (Html.BeginForm("Site", "ConnectionString", FormMethod.Get))
{ 
    <section id="filter-bar">
        <div class="filter-form">
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.Name)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Name)
            </div>
            <div class="submit">
                <input type="submit" value="Submit" />
            </div>
        </div>
    </section>
}
<table class="grid">
    <thead>
        <tr>
            <th>
                @ViewResource.ID
            </th>
            <th>
                @ViewResource.Name
            </th>
            <th>
                @ViewResource.Description
            </th>
            <th>
                @ViewResource.Modifier
            </th>
            <th>
                @ViewResource.Modified_Date
            </th>
            <th>
                @ViewResource.Active
            </th>
            <th>
                @ViewResource.Connection
            </th>
            @if (Model.HasEditPermission)
            { 
                <th>
                    @ViewResource.Edit
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @if (!ReferenceEquals(Model.Sites, null))
        {
            int i = 0;
            var disable = Model.HasEditPermission ? string.Empty : "disabled";
            foreach (var item in Model.Sites)
            {
                string rowCss = i % 2 == 0 ? string.Empty : "class=\"alt\"";
                i++;
            <tr class="@rowCss">
                <td class="width-30 align-center">
                    @item.Id
                </td>
                <td>
                    @item.Name
                </td>
                <td>
                    @item.Description
                </td>
                <td>
                    @item.Modifier.Name
                </td>
                <td class="align-center">
                    @item.ModifiedDate.ToFullDateString()
                </td>
                <td class="align-center">
                    @if (item.IsActive)
                    {
                        <input type="checkbox" checked="checked" sid="@item.Id" sname="@item.Name" class="update-status" @disable/>
                    }
                    else
                    {
                        <input type="checkbox" sid="@item.Id" sname="@item.Name" class="update-status" @disable/>
                    }
                </td>
                <td class="align-center">
                    <a href="#" class="connection" sid="@item.Id">@ViewResource.View</a>
                </td>
                @if (Model.HasEditPermission)
                { 
                    <td class="align-center">
                        @Html.ActionLink("Edit", "EditSite", new { id = item.Id })
                    </td>
                }
            </tr>
            }
            if (i == 0)
            {
            <tr>
                <td colspan="10" class="align-center">
                    @ViewResource.NoInformationAvailable
                </td>
            </tr>
            }
        }
    </tbody>
</table>
@section Foot {
    @Scripts.Render("~/scripts/connectionstring-site")
}
