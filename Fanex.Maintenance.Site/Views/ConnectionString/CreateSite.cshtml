@using Fanex.Maintenance.ViewModel.Connection
@model SiteViewModel
@{  
    ViewBag.Title = ViewResource.Create + ViewResource.Site;
    Layout = "~/Views/Shared/_Layout.cshtml";    
}
@{
    ViewBag.Title = string.Format("{0} {1}", ViewResource.Create_New, ViewResource.Site);
    bool success = ViewBag.Success != null && ViewBag.Success;    
}
@section Head {
    @Styles.Render("~/css/manage")
    <style type="text/css">
        .form .form-row .rdo-field, .form .form-row .chk-field
        {
            padding: 3px 0 0;
        }
    </style>
}
@section Headline {
    <h1>
        <span class="title">@ViewBag.Title</span>
        @Html.ActionLink("← " + ViewResource.Back_To_List, "Site", "ConnectionString", null, new { @class = "lnk" })
    </h1>
}
@using (Html.BeginForm())
{
    <div class="form">
        <div class="form-row summary">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @Html.ValidationSummary()
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Name)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Name)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Description)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Description)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.Label(ViewResource.Status)
            </div>
            <div class="edit-field chk-field">
                @Html.CheckBoxFor(m => m.IsActive)
                @Html.LabelFor(m => m.IsActive, ViewResource.Active)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @if (!success)
                {
                    <input type="submit" value="@ViewResource.Save" />
                    <button class="cancel" onclick="NAP.redirect('ConnectionString/Site', 0); return false;">@ViewResource.Cancel</button>
                }
            </div>
        </div>
    </div>    
}
@section Foot
{
    @if (success)
    {
        string dialogMsg = string.Format(ViewResource.AddSuccessMsg, ViewResource.Site, 3);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'ConnectionString/Site/', 2000);
            });
        </script>
    }
}
