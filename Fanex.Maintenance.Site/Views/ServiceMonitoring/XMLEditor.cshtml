@using Fanex.Maintenance.Repository.Criteria.ServiceMonitoring
@model ServiceMonitoringCriteria
@{
    Layout = null;
    ViewBag.Title = "XMLEditor";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width" />
    @Styles.Render("~/css/xml-editor")
</head>
<body>
<input id="IP" type=hidden value="@Model.IP" />
<input id="ServiceName" type=hidden value="@Model.ServiceName" />
<input id="ConfigFileName" type=hidden value="@Model.ConfigFileName" />
    <input id="XMLString" type=hidden value="@ViewBag.xmlstring" />
    <div id="XMLEditor">
    </div>
    <div style="text-align: center">
        <input id="SaveXML" type="button" class="ui-button-text" value="Save" />
    </div>
    @Scripts.Render("~/scripts/xml-editor")
    <script type="text/javascript">
        $(document).ready(function () {
            xmlEditor.loadXmlFromString($("#XMLString").val(), "#XMLEditor", function () {
                //xmlEditor.renderAsHTML();
                xmlEditor.renderTree();
            });
            //            xmlEditor.loadXmlFromString("<a></a>", "#XMLEditor", function () {
            //                //xmlEditor.renderAsHTML();
            //                xmlEditor.renderTree();
            //            });
            $('#SaveXML').click(function () {
                $.ajax({
                    url: NAP.resolveClientUrl("SaveServiceConfigFile"),
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        IP: $('#IP').val(),
                        ServiceName: $('#ServiceName').val(),
                        ConfigFileName: $('#ConfigFileName').val(),
                        FileText: xmlEditor.getXmlAsString()
                    },
                    cache: false,
                    beforeSend: function () {
                    },
                    complete: function () {
                    },
                    success: function (data) {
                        if (data == true) {
                            alert('File Save Successfully.');
                        }
                        else {
                            alert('File Save Failed.');
                        }
                    },
                    error: function () {
                        alert('error');
                    }
                });
            });
        });
    </script>
</body>
</html>
