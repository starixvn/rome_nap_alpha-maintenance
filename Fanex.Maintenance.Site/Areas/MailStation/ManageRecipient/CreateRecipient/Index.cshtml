@using Fanex.MailDelivery.MailStation.Resources;
@using Fanex.MailDelivery.MailStation.Models;
@using Fanex.MailDelivery.MailStation.Criteria.ManageRecipient;
@using Fanex.MailDelivery.MailStation.Resources;
@using Fanex.Maintenance.Repository;
@model CreateRecipientCriteria
@{
    ViewBag.Title = Labels.Insert_Recipient;
    Layout = "~/Views/Shared/_LayoutWithTimer.cshtml";  
}
@section Head {
    @Styles.Render("~/css/manage")
    <link href="~/themes/shared/formedit.less" rel="stylesheet" type="text/css" />
    <link href="~/Areas/MailStation/ManageRecipient/CreateRecipient/Styles/CreateRecipient.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@Labels.SystemName / </span><span
            class="second">
            @Labels.Manage_Recipient /</span>
            @ViewBag.Title
        </span>
        <div class="button-action">
            <a id="btnBackToList" class="lnk" href="~/MailStation/MailRecipient/Index">←
                @Labels.Back_to_list</a>
        </div>
    </h1>
}
<section id="body">
    <div class="form">
        <div id="validation-summary-row" class="form-row display-none">
            <div class="lbl-field width-100">
            </div>
            <div class="edit-field">
                <div id="validationSummary"></div>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.UserName, new { @class = "bold-weight" })
            </div>
            <div class="edit-field">
                @Html.EditorFor(m => m.UserName)
            </div>
            <a id="btn-loading" class="ico-loading display-none"></a>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Email1, string.Format("{0} {1}", Labels.Email, 1))
            </div>
            <div class="edit-field">
                @Html.EditorFor(m => m.Email1)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Email2, string.Format("{0} {1}", Labels.Email, 2))
            </div>
            <div class="edit-field">
                @Html.EditorFor(m => m.Email2)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Email3, string.Format("{0} {1}", Labels.Email, 3))
            </div>
            <div class="edit-field">
                @Html.EditorFor(m => m.Email3)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Note)
            </div>
            <div class="edit-field">
                @Html.EditorFor(m => m.Note)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.Status)
            </div>
            <div class="edit-field">
                @Html.CheckBoxFor(m => m.Status, new { @class = "check-box" })
            </div>
            @Html.HiddenFor(m => m.IsNAPUser)
            @Html.HiddenFor(m => m.NAPUserID)
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
            </div>
            <div class="edit-field">
                <input id="button-save" type="submit" value="@Labels.Save" />
                <input id="button-cancel" type="submit" value="@Labels.Cancel" />
            </div>
        </div>
    </div>
</section>
@section Foot {
    @Scripts.Render("~/scripts/sharedscripts")
    <script src="~/scripts/lib/ContextMenu/ContextMenuController.js" type="text/javascript" ></script>
    <script src="~/Areas/MailStation/ManageRecipient/CreateRecipient/Scripts/CreateRecipientController.js" type="text/javascript" ></script>
    <script type="text/javascript">
        var viewResources = {
            Confirm_CancelInsertRecipient: '@Labels.Confirm_CancelInsertRecipient',
            Confirm_InsertRecipient: '@Labels.Confirm_InsertRecipient',
            CreateRecipientSuccessMsg: '@string.Format(ViewResource.AddSuccessMsg, "Recipient", 5)',
        };
    </script>
}
