@using Fanex.Maintenance.Repository;
@using Fanex.MailDelivery.MailStation.Resources;
@using Fanex.MailDelivery.MailStation.Criteria.MailGroup;
@model CreateMailGroupCriteria
@{
    
    ViewBag.Title = "Create Group";
    Layout = "~/Views/Shared/_LayoutWithTimer.cshtml";  
}
@section Head {
    @Styles.Render("~/css/manage")
    <link href="~/themes/shared/contextmenu.less" rel="stylesheet" type="text/css" />
    <link href="~/Areas/MailStation/MailGroup/CreateMailGroup/Styles/CreateMailGroup.less"
        rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@Labels.SystemName / </span><span class="second">
            Manage Group /</span>
            @ViewBag.Title
        </span>
        <div class="button-action">
            <a id="btnBackToList" class="lnk" href="~/MailStation/MailGroupManage/Index">← Back
                to list</a>
        </div>
    </h1>
}
<section id="body">
    <div class="form">
        <div id="validation-summary-row" class="form-row display-none">
            <div class="lbl-field width-100">
            </div>
            <div class="edit-field">
                <div id="validationSummary"></div>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.MailGroupName, "Group", new { @class = "bold-weight" })
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.MailGroupName)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.Description, "Description")
            </div>
            <div class="edit-field ">
                @Html.TextAreaFor(m => m.Description)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                <input id="button-save" type="submit" value="@ViewResource.Save" />
                <input id="button-cancel" type="reset" value="@ViewResource.Cancel" />
            </div>
        </div>
    </div>
    @Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
</section>
@section Foot {
    @Scripts.Render("~/scripts/sharedscripts")
    <script src="~/scripts/lib/ContextMenu/ContextMenuController.js" type="text/javascript"></script>
    <script src="~/Areas/MailStation/MailGroup/CreateMailGroup/Scripts/CreateMailGroup.js" type="text/javascript"></script>
    <script type="text/javascript">
        var viewResources = {
            CreateMailGroupSuccessMsg: '@string.Format(ViewResource.AddSuccessMsg, "Mail Group", 5)',
            CancelCreateMailGroup: '@MailStationResources.CancelCreateMailGroup'
        };
    </script>
}
