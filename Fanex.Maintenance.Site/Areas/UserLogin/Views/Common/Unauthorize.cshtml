@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewResources.Unauthorize</title>
    <style type="text/css">
        html, body {
            margin: 0;
            padding: 0;
            border: 0;
            outline: 0;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Arial, Sans-Serif;
            color: #333;
        }
        .container {
            margin: 0 auto;
            padding: 20px;
            width: 960px;
            background-color: #549cba;
        }
        h1 {
            color: #fff;
            padding: 0 0 10px;
            font-weight: normal;
            border-bottom: solid 1px #fff;
        }
        a {
            color: #fff;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>
            @ViewResources.Unauthorize</h1>
        <p>
            You are not authorized to access the requested resource!<br />
            <a href="~/">Click here</a> to return to home page.
        </p>
    </div>
    <input type="hidden" value="{{server.unauthorize}}" />
</body>
</html>