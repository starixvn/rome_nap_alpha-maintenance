@using Alpha.Maintenance.Repository.Criteria.Log
@using Alpha.Maintenance.Core.Model

@model GetLogCriteria

@{
    ViewBag.Title = ViewResource.AppLogs_ViewLog;
    Layout = "~/Views/Shared/_Layout.cshtml";
    IEnumerable<Log> listLog = (IEnumerable<Log>)ViewBag.ListLog;
}

@section Head {
    @Styles.Render("~/css/log-index")
}

@section Headline {
    <span>App logs / </span>
    <span class="active">View logs</span>
}

@using (Html.BeginForm())
{
    <section id="filter-bar" style="width: 98%" ng-controller="logController">
        <div class="filter-form">
            <div class="row">
                <div class="input-field col l2 m3 s6">
                    @Html.LabelFor(m => m.CategoryId, ViewResource.Category, new { @class = "active" })
                    @Html.DropDownListFor(m => m.CategoryId, (List<SelectListItem>)ViewBag.ListCategory, new { @class = "width-large" })
                </div>
                <div class="input-field col l2 m3 s6">
                    <select id="MachineId" name="MachineId" class="width-large"></select>
                    @Html.LabelFor(m => m.MachineId, ViewResource.Machine, new { @class = "active" })
                </div>
                <div class="input-field col l2 m3 s6">
                    @Html.DropDownListFor(m => m.Severity, (List<SelectListItem>)ViewBag.ListSeverity, new { @class = "js-select" })
                    @Html.LabelFor(m => m.Severity, ViewResource.Severity)
                </div>
                <div class="input-field col l2 m3 s6">
                    @Html.DropDownListFor(m => m.IsMonitored, (List<SelectListItem>)ViewBag.LogStatus, new { @class = "js-select" })
                    @Html.LabelFor(m => m.IsMonitored, ViewResource.Status)
                </div>
            </div>
            <div class="row">
                <div class="input-field col l2 m3 s6">
                    <div class="lbl-field width-60">
                        @Html.LabelFor(m => m.From, ViewResource.From, new { @class = "active" })
                    </div>
                    <div class="calendar">
                        <input type="text" name="From" id="FromDate" class="c-datepicker-btn" value="@Model.From.ToString("MMM dd,yyyy HH:mm")" />
                    </div>
                </div>
                <div class="input-field col l2 m3 s6">
                    <div class="lbl-field width-40">
                        @Html.LabelFor(m => m.To, ViewResource.To, new { @class = "active" })
                    </div>
                    <div class="calendar">
                        <input type="text" name="To" id="ToDate" class="c-datepicker-btn" value="@Model.To.ToString("MMM dd,yyyy HH:mm")" />
                    </div>
                </div>
                <div class="input-field col l2 m3 s6">
                    @Html.DropDownListFor(m => m.ToGMT, (List<SelectListItem>)ViewBag.ListTimeZone, new { @class = "js-select" })
                    @Html.LabelFor(m => m.ToGMT, ViewResource.TimeZone)
                </div>
                <div class="input-field col l2 m3 s6">
                    @Html.TextBoxFor(m=>m.SearchText)
                    @Html.LabelFor(m => m.SearchText, "Search Text")
                </div>
            </div>
            <div class="row">
                <div class="col button-block">
                    <input class="waves-effect waves-light btn btn-primary" type="button" value="@ViewResource.Submit" id="submit" />
                    @if (Model.HasEdit)
                    {
                        <a href="#" id="btnRemoveLog" class="waves-effect btn btn-outline">
                            Delete log data (Before @DateTime.Now.AddDays(-5).ToString("MMM dd,yyyy"))
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>
    @Html.HiddenFor(m => m.Page)
    <div id="pagination-1">
    </div>
    <div class="table">
        <table class="grid persist-area" id="messageContainer">
            <thead class="persist-header">
                <tr>
                    <th>
                        #
                    </th>
                    <th>
                        Message
                    </th>
                    <th>
                        Category
                    </th>
                    <th>
                        Severity
                    </th>
                    <th>
                        Machine
                    </th>
                    <th class="width-100">
                        <lable for="chbMonitorAll">Messages</lable>
                    </th>
                    <th class="width-200">
                        <span id="timeZone">Time (GMT @(Model.ToGMT > 0 ? "+" + Model.ToGMT.ToString() : Model.ToGMT.ToString()))</span>
                    </th>
                </tr>
            </thead>
            <tbody id="content"></tbody>
        </table>
    </div>
    <div id="pagination-2">
    </div>
}

@Html.Hidden("HasEdit", Model.HasEdit ? 1 : 0)

@section Foot {
    @Scripts.Render("~/scripts/log-index")
    <script type="text/javascript">            
        var fromDate = new Date('@Model.From');
        var toDate = new Date('@Model.To');
    </script>
}