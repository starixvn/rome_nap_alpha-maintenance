@model IEnumerable<BotSystemSetting>

@if (Model.Any())
{
    foreach (var botSystemSetting in Model)
    {
        <tr>
            <td>@botSystemSetting.Id</td>
            <td>@botSystemSetting.ServiceName</td>
            <td>@botSystemSetting.SettingName</td>
            <td>@botSystemSetting.Value</td>
            <td>
                <a href="@Url.Action("UpdateBotSystemSetting", "Chatbot", new { Id = botSystemSetting.Id})"
                    class="text-link">
                    Edit
                </a>
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan = "8" class="no-data">@ViewResource.NoInformationAvailable</td>
    </tr>
}