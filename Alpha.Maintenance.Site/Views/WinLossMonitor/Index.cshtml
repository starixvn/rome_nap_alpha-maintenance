@{
    ViewBag.Title = "My Watchlist Monitor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Tuple<WinLossMonitorViewModel, WinLossMonitorViewModel>

@section Headline {
    <span>My Watchlist Monitor / </span>
    <span class="active">@(Model.Item1.IsCreditJob ? "Credit" : "Deposit") Jobs</span>
}
@section Foot {
    @Scripts.Render("~/Assets/bundles/WinLossMonitor/winloss-monitor.js")
}
<div class="filter-form">
    <form class="compose-announcement">
        <div class="row">
            <div class="col s12 m6 l4">
                <ul class="tabs">
                    <li class="tab">
                        <a href="#tab-pro">Production</a>
                    </li>
                    <li class="tab">
                        <a href="#tab-uat">UAT</a>
                    </li>
                </ul>
            </div>
        </div>
        <div id="tab-pro">
            @{ Html.RenderPartial("~/Views/WinLossMonitor/_GlobalSettingTab.cshtml", Model.Item1); }
        </div>
        <div id="tab-uat">
            @{ Html.RenderPartial("~/Views/WinLossMonitor/_GlobalSettingTab.cshtml", Model.Item2); }
        </div>
    </form>
</div>