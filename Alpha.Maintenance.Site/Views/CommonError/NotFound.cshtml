@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewResource.NoInformationAvailable</title>
    <style type="text/css">
        html, body
        {
            margin: 0;
            padding: 0;
            border: 0;
            outline: 0;
        }
        body
        {
            font-family: Tahoma, 'Segoe UI' , Arial, Sans-Serif;
            color: #333;
        }
        .container
        {
            margin: 0 auto;
            padding: 20px;
            width: 960px;
            background-color: #549cba;
        }
        h1
        {
            color: #fff;
            padding: 0 0 10px;
            font-weight: normal;
            border-bottom: solid 1px #fff;
        }
        a
        {
            color: #fff;
            text-decoration: none;
        }
        a:hover
        {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>
            404 >>> @ViewResource.NoInformationAvailable</h1>
        <p>
            The requested resources was not found on our server.<br />
            Please try to correct your URL or <a href="~/">click here</a> to return to home
            page.
        </p>
    </div>
    <input type="hidden" value="{{server.notfound}}" />
</body>
</html>
