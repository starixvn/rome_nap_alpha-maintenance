<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en" ng-app="app">
<!--<![endif]-->
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>@ViewBag.Title</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/0.97.6/css/materialize.min.css">
    @*<link href="http://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">*@
    <link href="~/styles/vendors/icon/style.css" rel="stylesheet" />
    <link href="~/styles/main.min.css" rel="stylesheet" />

    @RenderSection("Head", false)
</head>
<body>
    <header>

        <div class="navbar-fixed">
            <div class="container left">
                <a href="#" data-activates="nav-mobile" class="button-collapse top-nav waves-effect circle hide-on-large-only"><i class="material-icons">reorder</i></a>
            </div>
            <nav class="nav-wrapper">
                <div class="breadcrumb left"><span>Home / App logs / </span><span class="active">View logs</span></div>
                <div class="right profile">
                    <span>Howdy, @HttpContext.Current.User.Identity.Name</span>
                    @*<img src="images/ic-setting.png" />
                    <img src="images/ic-logout.png" />*@
                    @*<i class="icon-settings"></i>*@                    
                    <a class="icon-login" href="~/UserLogin/Login/LogOut"></a>
                </div>
            </nav>
        </div>

        <ul id="nav-mobile" class="side-nav fixed">
            <li class="logo">
                <a id="logo-container" href="http://materializecss.com/" class="brand-logo">
                    <span><img src="~/images/logo2.png" /> </span>
                    <span class="logo"><img src="~/images/logo.png" /></span>
                </a>
            </li>
            <li class="no-padding">
                @Html.Action("_Menu", new RouteValueDictionary(new { controller = "Home", area = "" }))
            </li>
        </ul>
    </header>

    <main>
        <div class="page-title">
            @RenderSection("Headline", false)
        </div>

        <div class="page-form">

            @RenderSection("FilterBar", false)

            @RenderBody()
        
        </div>
    </main>


    <div id="dialog-message">
    </div>
    <div id="details-modal" class="modal bottom-sheet">
        <div class="modal-content">
            <h4 id="modal-title"></h4>
            <div id="modal-content-data"></div>
        </div>
    </div>
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
    </script>
</body>
</html>

@Html.Hidden("NapAdminRoot", Url.Content("~/"))


<script src="https://code.jquery.com/jquery-2.1.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/0.97.6/js/materialize.min.js"></script>
<script src="~/scripts/init.js"></script>

@RenderSection("Foot", false)
@RenderSection("scripts", false)


@if (ViewBag.ViewFlags != null && ViewBag.ViewFlags.IsReCheckin)
{
    @Scripts.Render("~/scripts/recheckin")
}
