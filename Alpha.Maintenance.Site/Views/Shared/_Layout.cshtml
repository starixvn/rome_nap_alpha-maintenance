<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en" ng-app="app">
<!--<![endif]-->
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>@ViewBag.Title</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/0.97.6/css/materialize.min.css">
    <link href='https://fonts.googleapis.com/css?family=Roboto' rel='stylesheet' type='text/css'>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    @Styles.Render("~/css/common")

    @RenderSection("Head", false)
</head>
<body>
    <header>

        <div class="navbar-fixed">
            <div class="container left">
                <a href="#" data-activates="nav-mobile" class="button-collapse top-nav waves-effect hide-on-large-only">
                    <span class="icon-menu"></span>
                </a>
            </div>
            <nav class="nav-wrapper">
                <div class="breadcrumb left">
                    <a href="#" class="toggle-btn">
                        <span class="lines"></span>
                    </a>
                    @RenderSection("Headline", false)
                </div>
                <div class="right profile">
                    <span>Howdy, @HttpContext.Current.User.Identity.Name</span>                 
                    <a class="icon-login" href="~/Auth/LogOut"></a>
                </div>
            </nav>
        </div>

        <ul id="nav-mobile" class="side-nav fixed">
            <li class="logo">
                <a id="logo-container" href="#" class="brand-logo">
                    <span><img src="~/Assets/images/m7_logo.png" /> </span>                    
                </a>
            </li>
            <li class="no-padding">
                @Html.Action("_Menu", new RouteValueDictionary(new { controller = "Home", area = "" }))
            </li>
        </ul>
    </header>

    <main>
        <div class="page-form">

            @RenderSection("FilterBar", false)

            @RenderBody()
        
        </div>
    </main>

    <div id="dialog-message">
    </div>

    <div id="details-modal" class="modal">
        <div class="modal-content">
            <h4 id="modal-title"></h4>
            <div id="modal-content-data"></div>
        </div>
    </div>

</body>
</html>

@Html.Hidden("NapAdminRoot", Url.Content("~/"))

@Scripts.Render("~/scripts/common")

@RenderSection("Foot", false)
@RenderSection("scripts", false)

<script type="text/javascript">window.rootUrl = '@Url.Content("~")';</script>
@if (ViewBag.ViewFlags != null && ViewBag.ViewFlags.IsReCheckin)
{
    <script src="@Url.Content("~/auth/recheckinscript")" type="text/javascript"></script>
}
