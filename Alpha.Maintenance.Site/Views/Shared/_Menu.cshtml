@using Fanex.NAP.Core.Models
@{
    var menuItemList = ViewBag.Menu != null ? ViewBag.Menu as List<MenuItem> : new List<MenuItem>();
    var lvl0MenuItemList = menuItemList.Where(m => m.Parent == null).OrderBy(m => m.DisplayOrder).ToList();
}
<ul class="collapsible collapsible-expandable" data-collapsible="expandable">
    @for (int i = 0; i < lvl0MenuItemList.Count; i++)
    {
        var menuItem = lvl0MenuItemList[i];
        var lvl1MenuItemList = menuItemList.Where(x => x.Parent != null && x.Parent.Id == menuItem.Id)
            .OrderBy(x => x.DisplayOrder).ToList();

        if (lvl1MenuItemList.Any())
        {
            <li mid="@menuItem.Id" class="bold">
                <a class="collapsible-header waves-effect active">
                    <span class="menu-icon icon-view_logs" aria-hidden="true"></span>
                    <span class="menu-title">@menuItem.Name</span>
                    <i class="right icon-chevron-up"></i>
                </a>
                <div class="collapsible-body">
                    <ul>
                        @foreach (var subMenuItem in lvl1MenuItemList)
                        {
                            var isActive = HttpContext.Current.Request.Url.AbsoluteUri.ToLower().Contains(subMenuItem.Url.ToLower());

                            <li mid="@subMenuItem.Id" class="@(isActive ? "active" : string.Empty)">
                                <a href="@Url.Content(subMenuItem.ValidUrl)">@subMenuItem.Name</a>
                            </li>
                        }
                    </ul>
                </div>
            </li>

        }
        else
        {


            <li mid="@menuItem.Id">
                <a class="collapsible-header waves-effect" href="@Url.Content(menuItem.ValidUrl)">                    
                    <span class="menu-icon icon-view_logs" aria-hidden="true"></span>
                    <span class="menu-title">@menuItem.Name</span>                    
                </a>
            </li>
        }
    }
</ul>
