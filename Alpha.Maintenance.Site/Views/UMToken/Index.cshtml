@model TokenViewModel
@{
    ViewBag.Title = "UM Token";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Headline{
    <span class="active">UM Token</span>
}

<div class="table">
    <table class="grid persist-area" id="messageContainer">
        <thead class="persist-header">
            <tr>
                <th>@ViewResource.Site</th>
                <th>@ViewResource.ID</th>
                <th>@ViewResource.OldToken</th>
                <th>@ViewResource.Token</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.OldTokens.Keys.Any())
            {
                <tr>
                    <td colspan="2" class="no-data">@AnnouncementResources.NoInformation</td>
                </tr>
            }
            else
            {
                foreach (var site in Model.OldTokens.Keys)
                {
                    var oldToken = Model.OldTokens[site];
                    var newToken = Model.NewTokens.ContainsKey(site) ? Model.NewTokens[site] : null;
                    <tr>
                        <td>@site</td>
                        <td>@oldToken.SiteId</td>
                        <td>@oldToken.Token</td>
                        <td>@(newToken!=null ? newToken.Token : "")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>