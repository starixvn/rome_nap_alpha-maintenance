@model TokenViewModel
@{
    ViewBag.Title = "UM Token";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Headline{
    <span class="active">UM Token</span>
}

<div class="table">
    <table class="grid persist-area" id="messageContainer">
        <thead class="persist-header">
            <tr>
                <th>@ViewResource.Site</th>
                <th>@ViewResource.ID</th>
                <th>@ViewResource.Token</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.NewTokens.Keys.Any())
            {
                <tr>
                    <td colspan="3" class="no-data">@AnnouncementResources.NoInformation</td>
                </tr>
            }
            else
            {
                foreach (var site in Model.NewTokens.Keys)
                {
                    var token = Model.NewTokens[site];
                    <tr>
                        <td>@site</td>
                        <td>@token.SiteId</td>
                        <td>@token.Token</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>