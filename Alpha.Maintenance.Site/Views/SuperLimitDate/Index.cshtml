@{
    ViewBag.Title = "Customer Limit Date";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Headline {
    <span class="active">Customer Limit Date</span>
}

<section id="filter-bar">
    <div class="filter-form">
        <div class="row">
            <div class="input-field col l2">
                <input type="text" id="userName" value="" />
                <label class="active">User Name</label>
            </div>
            <div class="col button-block">
                <a class="waves-effect waves-light btn btn-primary"><input type="submit" id="submit" value="@ViewResource.Submit" /></a>
                @Html.ActionLink("Add Super", "Add", null, new { @class = "waves-effect btn btn-outline" })
            </div>
        </div>
    </div>
</section>

<div class="table">
    <table class="grid">
        <thead>
            <tr>
                <th class="center">
                    #
                </th>
                <th class="center">
                    User Name
                </th>
                <th class="center">
                    Limit Days
                </th>
                <th class="center">
                    Min Date
                </th>
                <th class="center">

                </th>
            </tr>
        </thead>
        <tbody id="content"></tbody>
    </table>
</div>

<div id="pagination-1">
</div>
@section Foot {
    @Scripts.Render("~/Assets/bundles/SuperLimitDate/index.js")
    <script>
        $(document).ready(function () {
            Super.getSuperLimitDate(50, 0);
        });
    </script>

}