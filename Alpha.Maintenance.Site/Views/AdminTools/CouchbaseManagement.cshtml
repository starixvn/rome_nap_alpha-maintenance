@using Alpha.Maintenance.Repository.Criteria.Log
@using Alpha.Maintenance.Core.Model

@model GetLogCriteria

@{
    ViewBag.Title = ViewResource.Couchbase_Management;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {

}

<div class="filter-form">
    <div class="row">
        <div id="error-message" class="card-panel lighten-4 text-darken-4 red red-text hiden"></div>
    </div>
    <div class="row">
        <div class="input-field col l2">
            <input type="text" id="custIds" value="" />
            <label class="active">Agent IDs</label>
        </div>
        <div class="col button-block">
            <a id="submit" class="waves-effect waves-light btn btn-primary"><input type="submit"  value="@ViewResource.Get" /></a>
            <input class="waves-effect btn btn-outline" id="del-document" type="button" value="Clear" />
        </div>
    </div>
    <div class="row ">
        <div class="table">
            <table id="result-table" class="grid">
                <thead>
                    <tr>
                        <th class="center l1">Agent ID</th>
                        <th class="center">Cache Value</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Headline {
    <span>@ViewResource.Admin_Tools / </span>
    <span class="active">Transfer Cached Items</span>
}

@section Foot {
    @Scripts.Render("~/Assets/bundles/Couchbase/CouchbaseManagement.js")
}
