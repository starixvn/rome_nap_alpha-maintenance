@using Alpha.Maintenance.Core.Model
@model Machine
@{
    ViewBag.Title = ViewResource.EditMachine;
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool success = ((ViewBag.Success != null) && (ViewBag.Success.Code == 0));
}

@section Head {
    <link href="~/styles/pages/manage.min.css" rel="stylesheet" />
}

@section Headline {
    @*<span class="title">@ViewResource.EditMachine</span>*@
    @Html.ActionLink("← " + ViewResource.Back_To_List, "Index", "Machine", null, new { @class = "waves-effect waves-light btn btn-primary" })
}
@using (Html.BeginForm())
{    
    <div class="row summary">
        <div class="lbl-field">
        </div>
        <div class="edit-field">
            @Html.ValidationSummary()
            @Html.HiddenFor(m => m.MachineId)
        </div>
    </div>
    <div class="row">
        <div class="input-field col s6">
            @Html.LabelFor(m => m.MachineName, ViewResource.Machine_Name, new { @class = "active" })
            @Html.TextBoxFor(m => m.MachineName)
        </div>
    </div>
    <div class="row">
        <div class="input-field col s6">
            @Html.LabelFor(m => m.MachineIP, ViewResource.Machine_IP, new { @class = "active" })
            @Html.EditorFor(m => m.MachineIP)
        </div>
    </div>
    <div class="row">
        <div class="input-field col s6 checkbox">
            @*@Html.LabelFor(m => m.IsProduction, ViewResource.IsProduction)
            @Html.EditorFor(m => m.IsProduction)*@
            <input name="group1" type="checkbox" id="test1" checked />
            <label for="test1">Is Production</label>
        </div>
    </div>
    <div class="row">
        <div class="input-field col s6">
            @Html.LabelFor(m => m.TimeZone, ViewResource.TimeZone, new { @class = "active" })
            @Html.EditorFor(m => m.TimeZone)
        </div>
    </div>
    <div class="row">
        <div class="input-field col s6">
            @if (!success)
            {
                <input class="waves-effect waves-light btn btn-primary" type="submit" value="@ViewResource.Save" />
                <input class="waves-effect waves-light btn btn-cancel" type="reset" value="@ViewResource.Cancel" />
            }
        </div>
    </div>    
}
@section Foot
{
    <script type="text/javascript">
        $(function () {
            $('input[type=reset]').bind('click', function () {
                window.location.replace(NAP.resolveClientUrl('Machine'));
            });
        });
    </script>
    @if (success)
    {
        string dialogMsg = string.Format(ViewResource.AddSuccessMsg, ViewResource.Machine + " '" + Model.MachineName, 5);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'Machine', 6000);
            });

        </script>
    }
}
