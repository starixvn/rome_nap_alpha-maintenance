@using Alpha.Maintenance.Repository.Criteria.Log
@using Alpha.Maintenance.Core.Model
@{
    ViewBag.Title = ViewResource.AppLogs_MangeMachines;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hasEditRight = (bool)ViewBag.HasEdit;
}
@section Headline {
    @*<h4 class="title">@ViewResource.AppLogs_MangeMachines</h4>
    @if (hasEditRight)
    {
        @Html.ActionLink("+ Create New", "InsertMachine", "Machine", new { @class = "lnk" })
    }*@
}
@using (Html.BeginForm()){
    <section id="filter-bar">
        <div class="row">
            <div class="input-field col l2 m3 s6">
                @Html.DropDownList("MachineType", (List<SelectListItem>)ViewBag.MachineTypes, new { @class = "js-select" })
                @Html.Label(ViewResource.MachineType)
            </div>
            <div class="col button-block">
                <a class="waves-effect waves-light btn btn-primary"><input type="submit" value="@ViewResource.Submit" /></a>
                @*<a class="waves-effect btn-flat">Create New</a>*@
                @if (hasEditRight)
                {
                    @Html.ActionLink("+ Create New", "InsertMachine", "Machine", new { @class = "waves-effect btn btn-create" })
                }
            </div>            
        </div>
    </section>
}

<div class="table">
    <table class="grid">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>
                    @ViewResource.Machine_Name
                </th>
                <th>
                    @ViewResource.Machine_IP
                </th>
                <th>
                    @ViewResource.TimeZone
                </th>
                <th>
                    @ViewResource.IsProduction
                </th>
                @if (hasEditRight)
            {
                    <th>
                        @ViewResource.Edit
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
                IEnumerable<Machine> machineList = ViewBag.Machines as IEnumerable<Machine>;
                if (!ReferenceEquals(machineList, null))
                {
                    foreach (Machine machine in machineList)
                    {
                        string row_class = i % 2 == 0 ? "alt" : string.Empty;

                        <tr class="@row_class">
                            <td class="align-center">
                                @i
                            </td>
                            <td>
                                @machine.MachineName
                            </td>
                            <td class="align-center">
                                @machine.MachineIP
                            </td>
                            <td class="align-center">
                                GMT (@(machine.TimeZone > 0 ? "+" + machine.TimeZone : machine.TimeZone.ToString()))
                            </td>
                            <td>
                                @(machine.IsProduction ? Html.Raw("<span class='btn-check'/>") : Html.Raw(string.Empty))
                            </td>
                            @if (hasEditRight)
                            {
                                <td class="align-center">
                                    <div class="action-wrp">
                                        @Html.ActionLink("Machine", "EditMachine", new { id = machine.MachineId }, new { @class = "btn-edit" })
                                    </div>
                                </td>
                            }
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            @ViewResource.NoInformationAvailable
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>


