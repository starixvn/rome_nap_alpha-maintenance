@model ComposeAnnouncementViewModel

@{
    var specifications = Model.Specifications.ToList();
}

<div id="specs-setting" class="row">
    <div class="col s12 row">
        <div class="col s3">
            @AnnouncementResources.CloneSpecification
        </div>
        <div class="col s4">
            <input type="text" name="txtCloneSetting" id="txtCloneSetting" value="" />
        </div>
        <div class="col s3">
            <input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" name="btnClone" id="btnClone" value="@AnnouncementResources.Clone" />
        </div>
    </div>

    <div class="row">
        <div class="col s1">
            &nbsp;
        </div>
        <div class="col s5">
            @AnnouncementResources.Specification
        </div>
        <div class="col s6">
            @AnnouncementResources.Value
        </div>
    </div>

    <div class="row">
        <div class="divider col s10"></div>
    </div>

    @if (specifications.Any())
    {
        foreach (var specification in specifications)
        {

            var isShowSpec = false;
            if (Model.Announcement.Specifications != null)
            {
                isShowSpec = Model.Announcement.Specifications.Any(existedSpec => existedSpec.Id.Equals(specification.Id));
            }


            <div data-jsonobject="@JsonConvert.SerializeObject(specification)" class="row @(isShowSpec ? string.Empty : "hiden")" name="div-specification" id="@specification.Id">
                <div class="col s1">
                    @Html.EnumDropDownList("dll-specification-conjunctionOperator", specification.ConjunctionOperator,
                          new Dictionary<string, object>() { { "data-parentId", specification.Id } })
                    &nbsp;
                </div>
                <div class="col s2">
                    @specification.Name
                </div>
                <div class="col s2">
                    @Html.EnumDropDownList("dll-specification-specificationOperator", specification.SpecificationOperator,
                          new Dictionary<string, object>() { { "data-parentId", specification.Id } })
                </div>
                <div class="col s3">

                    @if (specification.Name.Equals("User Level"))
                    {
                        <select name="dll-specification-value" multiple data-parentId="@specification.Id">
                            @foreach (var userLevel in specification.ValueRange)
                            {
                                <option value="@userLevel.Id" selected>@userLevel.Name</option>
                            }
                        </select>
                    }

                    else if (specification.Name.Equals("Sites"))
                    {
                        <select name="dll-specification-value"  multiple data-parentId="@specification.Id">
                            @foreach (var site in specification.ValueRange)
                            {
                                <option value="@site.Id" selected>@site.Name</option>
                            }
                        </select>
                    }
                </div>
                <div class="col s3 hidden-specification link" data-id="@specification.Id" data-name="@specification.Name">
                    - @AnnouncementResources.DeleteSpecification
                </div>
            </div>
            
        }

        <div class="row @(Model.ChoosenSpecifications.Count().Equals(0)? "hiden" : string.Empty)" id="div-choose-specification">
            <div class="col s1">
                &nbsp;
            </div>
            <div class="col s2">
                @Html.DropDownList("dll-choose-specification", Model.ChoosenSpecifications)
            </div>
            <div class="col s2">
                &nbsp;
            </div>
            <div class="col s3">
                &nbsp;
            </div>
            <div class="col s3 hidden-specification link">
                - @AnnouncementResources.DeleteSpecification
            </div>
        </div>
    }

    <div id="add-spec" class="row hiden">
        <div class="col s12 link">
            + @AnnouncementResources.AddSpecification
        </div>
    </div>

    <div class="row">
        <div class="col s1" name="btnPrev" id="btnPrev">
            <input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" value="@AnnouncementResources.Prev" />
        </div>
        <div class="col s2">
            <input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" name="btnSave" id="btnSaveStep2" value="@AnnouncementResources.Save" />
        </div>
        <input type="hidden" id="actionType" value="@Model.ActionType">
        <input type="hidden" id="AnnouncementId" value="@Model.Announcement.Id">
        <input type="hidden" id="number-of-specifications" value="@Model.Specifications.Count()">
    </div>
</div>