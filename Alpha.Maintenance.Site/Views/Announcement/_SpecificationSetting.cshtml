@model ComposeAnnouncementViewModel

<div id="specs-setting" class="row">
    <div class="row">
        <div class="col s1">
            &nbsp;
        </div>
        <div class="col s5">
            @AnnouncementResources.Specification
        </div>
        <div class="col s6">
            @AnnouncementResources.Value
        </div>
    </div>

    <div class="row">
        <div class="col s1"> &nbsp;</div>
        <div class="divider col s8"></div>
    </div>

    @foreach (var specification in Model.Announcement.Specifications)
    {
        @RenderSpecification(specification);
    }

    @foreach (var specification in Model.NotExistedSpecifications)
    {
        @RenderSpecification(specification, false);
    }

    <div class="row @(Model.NotExistedSpecifications.Count().Equals(0)? "hiden" : string.Empty)" id="div-choose-specification">
        <div class="col s1">
            &nbsp;
        </div>
        <div class="col s2">
            <select id="dll-choose-specification" name="dll-choose-specification">
                @foreach (var specification in Model.NotExistedSpecifications)
                {
                    <option value="@specification.Id" selected>@specification.Name</option>
                }
            </select>
        </div>
        <div class="col s2">
            &nbsp;
        </div>
        <div class="col s3">
            &nbsp;
        </div>
        <div class="col s3 hidden-specification link">
            - @AnnouncementResources.DeleteSpecification
        </div>
    </div>

    <div id="add-spec" class="row hiden">
        <div class="col s12 link">
            + @AnnouncementResources.AddSpecification
        </div>
    </div>

    <div class="row">
        <div class="col s1" name="btnPrev" id="btnPrev">
            <input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" value="@AnnouncementResources.Prev" />
        </div>
        <div class="col s2">
            <input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" name="btnSave" id="btnSaveStep2" value="@AnnouncementResources.Save" />
        </div>
        <input type="hidden" id="actionType" value="@Model.ActionType">
        <input type="hidden" id="AnnouncementId" value="@Model.Announcement.Id">
        <input type="hidden" id="number-of-specifications" value="@(Model.NotExistedSpecifications.Count() + Model.Announcement.Specifications.Count())">
    </div>
</div>

@helper RenderSpecification(ISpecification<IParam> specification, bool isShowSpec = true)
{
    <div data-jsonobject="@JsonConvert.SerializeObject(specification)" class="row @(isShowSpec ? string.Empty : "hiden")" name="div-specification" id="@specification.Id">
        <div class="col s1">
            @Html.EnumDropDownList("dll-specification-conjunctionOperator", specification.ConjunctionOperator,
                          new Dictionary<string, object>() { { "data-parentId", specification.Id } })
            &nbsp;
        </div>
        <div class="col s2">
            @specification.Name
        </div>
        <div class="col s2">
            @Html.EnumDropDownList("dll-specification-specificationOperator", specification.SpecificationOperator,
                          new Dictionary<string, object>() { { "data-parentId", specification.Id } })
        </div>
        <div class="col s3">
            @if (specification.Name.Equals("User Level"))
            {
                @RenderSpecDll(specification, isShowSpec);
            }

            else if (specification.Name.Equals("Sites")
                     || specification.Name.Equals("User Ids")
                     || specification.Name.Equals("Currencies")
                     || specification.Name.Equals("Products"))
            {
                @RenderSpecTxt(specification, isShowSpec);
            }
        </div>
        <div class="col s3 hidden-specification link" data-id="@specification.Id" data-name="@specification.Name">
            - @AnnouncementResources.DeleteSpecification
        </div>
    </div>
}

@helper RenderSpecDll(ISpecification<IParam> specification, bool isShowSpec)
{
    <select id="dll-specification-value" multiple data-specificationId="@specification.Id">
        @foreach (var userLevel in AppSettings.AnnouncementConfig.Levels)
        {
            <option value="@userLevel.Id" @(isShowSpec && specification.Value.Contains((byte)userLevel.Id) ? "selected" : string.Empty)>@userLevel.Name</option>
        }
    </select>
}

@helper RenderSpecTxt(ISpecification<IParam> specification, bool isShowSpec)
{
    <input type="text" id="txt-specification-value"
           value="@(isShowSpec ? string.Join(",", specification.Value?? string.Empty) : string.Empty)"
           data-specificationId="@specification.Id" />
}