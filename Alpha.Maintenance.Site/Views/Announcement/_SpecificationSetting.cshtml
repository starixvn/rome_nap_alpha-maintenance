@model ComposeAnnouncementViewModel

<div id="specs-setting" class="row">
    <div class="col s12 row">
        <div class="col s3">
            Clone Specification Setting From
        </div>
        <div class="col s4">
            <input type="text" name="txtCloneSetting" id="txtCloneSetting" value="" />
        </div>
        <div class="col s3">
            <input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" name="btnClone" id="btnClone" value="Clone" />
        </div>
    </div>
    <div class="row">
        <div class="col s12">
            <div class="col s1">
                &nbsp;
            </div>
            <div class="col s5">
                Specification
            </div>
            <div class="col s6">
                Value
            </div>
        </div>
    </div>
    <div class="row">
        <div class="divider col s10"></div>
    </div>

    @if (Model.Announcement.Specifications.Any())
    {
        var firstSpecification = Model.Announcement.Specifications.First();
        <div class="row" id="specification_@firstSpecification.Id">
            <div class="col s12">
                <div class="col s1">
                    &nbsp;
                </div>
                <div class="col s2">
                    @firstSpecification.Name
                </div>
                <div class="col s2">
                    @Html.EnumDropDownList("specification.SpecificationOperator", firstSpecification.SpecificationOperator)
                </div>
                <div class="col s3">
                    @if (firstSpecification.ValueRange == null)
                    {
                        <select multiple>
                            @foreach (var value in firstSpecification.Value)
                            {
                                <option value="@value" selected> @value</option>
                            }
                        </select>
                    }
                    else
                    {
                        <select>
                            @foreach (var level in firstSpecification.ValueRange)
                            {
                                <option value="@level.Id" selected> @level.Name</option>
                            }
                        </select>
                    }

                </div>
                <div class="col s3 hidden-specification link">
                    - Delete Specification
                </div>
                <input type="hidden" id="@firstSpecification.Name" value="@JsonConvert.SerializeObject(firstSpecification)">
            </div>
        </div>

        foreach (var specification in Model.Announcement.Specifications.Skip(1))
        {
            <div class="row @(Model.ActionType.Equals(ActionType.Create) ? "hiden" : string.Empty)" id="specification_@specification.Id">
                <div class="col s12">
                    <div class="col s1">
                        @Html.EnumDropDownList("Specification.ConjunctionOperator", specification.ConjunctionOperator)
                    </div>
                    <div class="col s2">
                        @specification.Name
                    </div>
                    <div class="col s2">
                        @Html.EnumDropDownList("specification.SpecificationOperator", specification.SpecificationOperator)
                    </div>
                    <div class="col s3">
                        @if (specification.ValueRange == null)
                        {
                            <select multiple>
                                @foreach (var value in specification.Value)
                                {
                                    <option value="@value" selected> @value</option>
                                }

                            </select>
                        }
                        else
                        {
                            <select>
                                @foreach (var level in specification.ValueRange)
                                {
                                    <option value="@level.Key" selected> @level.Value</option>
                                }
                            </select>
                        }

                    </div>
                    <div class="col s3 hidden-specification link">
                        - Delete Specification
                    </div>
                    <input type="hidden" id="@specification.Name" value="@JsonConvert.SerializeObject(specification)">
                </div>
            </div>
        }
    }
    <div class="row">
        <div class="col s12 link" id="add-spec">

            + Add Specification

        </div>
    </div>
    <div class="row">
        <div class="col s12">
            <div class="col s1">
                <input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" name="btnNext" id="btnPrev" value="Prev" />
            </div>
            <div class="col s2">
                <input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" name="btnSave" id="btnSave" value="@AnnouncementResources.Save" />
            </div>
            <input type="hidden" id="actionType" value="@Model.ActionType">
            <input type="hidden" id="AnnouncementId" value="@Model.Announcement.Id">
            <input type="hidden" id="number-of-specifications" value="@Model.Announcement.Specifications.Count()">
        </div>
    </div>
</div>