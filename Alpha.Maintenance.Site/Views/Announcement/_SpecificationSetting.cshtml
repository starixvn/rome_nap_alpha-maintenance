@model ComposeAnnouncementViewModel

@{
    var specifications = Model.ActionType.Equals(ActionType.Create) ? Model.Specifications : Model.Announcement.Specifications;
}

<div id="specs-setting" class="row">
    <div class="col s12 row">
        <div class="col s3">
            @AnnouncementResources.CloneSpecification
        </div>
        <div class="col s4">
            <input type="text" name="txtCloneSetting" id="txtCloneSetting" value="" />
        </div>
        <div class="col s3">
            <input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" name="btnClone" id="btnClone" value="@AnnouncementResources.Clone" />
        </div>
    </div>
    <div class="row">
        <div class="col s1">
            &nbsp;
        </div>
        <div class="col s5">
            @AnnouncementResources.Specification
        </div>
        <div class="col s6">
            @AnnouncementResources.Value
        </div>
    </div>
    <div class="row">
        <div class="divider col s10"></div>
    </div>

    @if (specifications.Any())
    {
        <div class="row" id="div-choose-specification">
            <div class="col s1">
                &nbsp;
            </div>
            <div class="col s2">
                <select name="dll-choose-specification" id="dll-choose-specification">
                    @foreach (var spec in Model.Specifications)
                    {
                        <option value="@spec.Id"> @spec.Name</option>
                    }
                </select>
            </div>
            <div class="col s2">
                &nbsp;
            </div>
            <div class="col s3">
                &nbsp;
            </div>
            <div class="col s3 hidden-specification link">
                - @AnnouncementResources.DeleteSpecification
            </div>
        </div>

        foreach (var specification in specifications)
        {
            <div data-jsonobject="@JsonConvert.SerializeObject(specification)" class="row @(Model.ActionType.Equals(ActionType.Create) ? "hiden" : string.Empty)" name="div-specification" id="specification_@specification.Id">
                <div class="col s1">
                    @Html.EnumDropDownList("dll-specification-conjunctionOperator", specification.ConjunctionOperator,
                        new Dictionary<string, object>() { { "data-parentId", specification.Id } })
                    &nbsp;
                </div>
                <div class="col s2">
                    @specification.Name
                </div>
                <div class="col s2">
                    @Html.EnumDropDownList("dll-specification-specificationOperator", specification.SpecificationOperator,
                        new Dictionary<string, object>() { { "data-parentId", specification.Id } })
                </div>
                <div class="col s3">
                    @if (specification.ValueRange == null)
                        {
                        <select name="dll-specification-value" multiple>
                            @foreach (var value in specification.Value)
                                {
                                <option value="@value" selected> @value</option>
                                }
                        </select>
                        }
                        else
                        {
                        <select name="dll-specification-value">
                            @foreach (var level in specification.ValueRange)
                                {
                                <option value="@level" selected> @level</option>
                                }
                        </select>
                        }

                </div>
                <div class="col s3 hidden-specification link" data-id="@specification.Id" data-name="@specification.Name">
                    - @AnnouncementResources.DeleteSpecification
                </div>
            </div>
        }
    }
    <div id="add-spec" class="row hiden">
        <div class="col s12 link">
            + @AnnouncementResources.AddSpecification
        </div>
    </div>
    <div class="row">
        <div class="col s1">
            <input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" name="btnNext" id="btnPrev" value="@AnnouncementResources.Prev" />
        </div>
        <div class="col s2">
            <input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" name="btnSave" id="btnSaveStep2" value="@AnnouncementResources.Save" />
        </div>
        <input type="hidden" id="actionType" value="@Model.ActionType">
        <input type="hidden" id="AnnouncementId" value="@Model.Announcement.Id">
        <input type="hidden" id="number-of-specifications" value="@Model.Specifications.Count()">
    </div>
</div>