@model ComposeAnnouncementViewModel

<div id="display-information-settings" class="display-information-settings">
    <div class="row">
        <div class="col l5 input-field">
            <input type="text" id="txttitle" class="validate" required="" aria-required="true" value="@Model.Announcement.Title" />
            <label for="txttitle">@AnnouncementResources.Title <span class="red-text">*</span></label>
        </div>
        <div class="col l4 input-field">
            <input type="text" id="txtcode" value="@Model.Announcement.Code" />
            <label for="txtcode">@AnnouncementResources.Code</label>
        </div>
        <div class="col l3 toggle-switch">
            <input class="sw" type="checkbox" id="ChkActive" @(Model.Announcement.IsActive ? "checked" : string.Empty) />
            <label class="input-field" for="ChkActive"><span>@AnnouncementResources.Active</span></label>
        </div>
    </div>
    <div class="content-group hiden row" id="content-group">
        <div class="col s12">
            <div class="txt-bold">@AnnouncementResources.Content</div>
            <ul class="tabs">
                @foreach (var content in Model.Announcement.Contents)
                {
                    <li class="tab language-tab"><a href="#div-@content.LanguageKey">@content.LanguageKey</a></li>
                }
            </ul>
        </div>

        @foreach (var content in Model.Announcement.Contents)
        {
            <div id="div-@content.LanguageKey" class="language-content">
                <textarea name="group-contents" id="@content.LanguageKey" class="jqte-test">@content.Text</textarea>
                <div class="input-field col s12">
                    <input type="text" id="txtannouncement-url" value="@content.Url" />
                    <label for="txtannouncement-url">@AnnouncementResources.AnnouncementUrl</label>
                </div>
            </div>
        }
    </div>

    <div class="row systems">
        <div class="col s2 checkbox">
            <input type="checkbox" id="IsPopup" @(Model.IsPopup ? "checked" : string.Empty) />
            <label for="IsPopup">@ViewResource.IsPopup</label>
        </div>
        <input type="hidden" id="EmergencyPopupId" value="@((int)AnnouncementType.EmergencyPopup)" />
        <input type="hidden" id="NormalAnnouncementId" value="@((int)AnnouncementType.Normal)" />
    </div>

    <div class="row systems">
        <div class="input-field col s4">
            <label class="active">@ViewResource.ReleasedDate</label>
            <input type="text" name="ReleasedDate" id="ReleasedDate" class="c-datepicker-btn" value="@Model.Announcement.ReleasedDate.ToLongDate()" />
        </div>
        <div class="input-field col s4 @(Model.IsPopup ? string.Empty: "hide") " id="expiredDateSection">
            <label class="active">@AnnouncementResources.ExpiredDate</label>
            <input type="text" name="ExpiredDate" id="ExpiredDate" class="c-datepicker-btn" value="@Model.Announcement.ExpiredDate.ToLongDate()" />
        </div>
    </div>

    <div class="row">
        <div class="col s12">
            <label class="label-title">@AnnouncementResources.Environments</label>
        </div>
        @foreach (var environment in AppSettings.AnnouncementConfig.Environments)
            {
            <div class="col s2 checkbox">
                <input name="group-environments" type="checkbox" id="@environment"
                       @(Model.Announcement.Environments.Contains(environment) ? "checked" : string.Empty) />
                <label for="@environment">@environment</label>
            </div>
        }
    </div>

    <div class="row systems">
        <div class="col s12"><label class="label-title">@AnnouncementResources.Systems</label></div>

        @foreach (var system in AppSettings.AnnouncementConfig.Systems)
            {
            <div class="col s2 checkbox">
                <input name="group-systems" type="checkbox" id="@system"
                       @(Model.Announcement.Systems.Contains(system) ? "checked" : string.Empty) />
                <label for="@system">@system</label>
            </div>
        }

    </div>

    <div class="row">
        <div class="col s12 button-group">
            <a class="btn btn-info  waves-effect waves-light btn btn-primary btnNext">@AnnouncementResources.Next</a>
            <a class="btn btn-info  waves-effect waves-light btn btn-primary btnSave">@AnnouncementResources.Save</a>

            @if (Model.ActionType.Equals(ActionType.Update))
            {
                <a class="btn btn-info  waves-effect waves-light btn btn-outline btnCopy">@AnnouncementResources.MakeACopy</a>
            }
        </div>
    </div>

</div>