@model ComposeAnnouncementViewModel

@{
    ViewBag.Title = "Compose message";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Styles.Render("~/Assets/scripts/lib/jQuery-TE.1.4.0/jquery-te-1.4.0.css")

@section Headline {
    <span>@AnnouncementResources.Announcement / </span>
    <span class="active">@AnnouncementResources.ComposeMessage</span>
}


<div class="row">
    <div class="col s6">
        <ul class="tabs">
            <li class="tab"><a id="tab-information-settings" href="#display-information-settings">1) @AnnouncementResources.DisplayInformationSettings</a></li>
            <li class="tab"><a id="tab-specs-setting" href="#specs-setting"> 2) @AnnouncementResources.SpecificationSetting</a></li>
        </ul>
    </div>
</div>

<div class="divider"></div>

@Html.Partial("_DisplaySetting", Model)

@Html.Partial("_SpecificationSetting", Model)

<input type="hidden" id="actionType" value="@Model.ActionType">
<input type="hidden" id="AnnouncementId" value="@Model.Announcement.Id">

<input type="hidden" id="announcementObject" value="@JsonConvert.SerializeObject(Model)">

<script type="text/javascript" src="http://code.jquery.com/jquery.min.js" charset="utf-8"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/0.97.6/js/materialize.min.js"></script>

@Scripts.Render("~/Assets/scripts/lib/jQuery-TE.1.4.0/jquery-te-1.4.0.min.js")
@Scripts.Render("~/Assets/scripts/lib/Momentjs/moment.min.js")
@Scripts.Render("~/Assets/scripts/lib/Select2/select2.js")
@Scripts.Render("~/scripts/common")

@Scripts.Render("~/scripts/defiant")
@Scripts.Render("~/Assets/scripts/Announcement/compose-messages.js")