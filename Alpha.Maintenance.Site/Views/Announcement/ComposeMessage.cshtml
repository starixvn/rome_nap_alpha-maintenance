@model Announcement

@Styles.Render("~/Assets/scripts/lib/jQuery-TE.1.4.0/jquery-te-1.4.0.css")

@{
    ViewBag.Title = "Compose message";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Headline {
    <span>@AnnouncementResources.Announcement / </span>
    <span class="active">>@AnnouncementResources.ComposeMessage</span>
}

<form role="form" id="report-form" action="">
    <div>
        <div class="row">
            <div class="col l2">
            </div>
            <div class="col l10">
                @AnnouncementResources.DisplayInformationSettings
            </div>
        </div>
        <div class="divider"></div>
        <div class="row">
            <div class="col l6">
                <div class="col l5">
                    @AnnouncementResources.Code:<input type="text" name="txtcode" id="txtcode" value="@Model.Code" />
                </div>
                <div class="col l5">
                    @AnnouncementResources.Title:<input type="text" name="txttitle" id="txttitle" value="@Model.Title" />
                </div>
                <div class="col l2">
                    <input type="checkbox" id="ChkActive" @(Model.IsActive ? "checked": string.Empty) /><label for="ChkActive">@AnnouncementResources.Active</label>
                </div>
                <div class="col l12">
                    @AnnouncementResources.Content
                </div>
                <ul id="tabs-swipe-demo" class="tabs">
                    <li class="tab col s3"><a href="#txtarea-eng"></a></li>
                    <li class="tab col s3"><a class="active" href="#txtarea-cn">zh-CN</a></li>
                    <li class="tab col s3"><a href="#txtarea-tw">zh-TW</a></li>
                    <li class="tab col s3"><a href="#txtarea-ja">ja-JP</a></li>
                    <li class="tab col s3"><a href="#txtarea-ko">ko-KR</a></li>
                    <li class="tab col s3"><a href="#txtarea-th">th-TH</a></li>
                    <li class="tab col s3"><a href="#txtarea-vi">vi-VN</a></li>
                </ul>
              
                <div id="txtarea-eng" class="col l12">
                    <textarea name="textarea" class="jqte-test"></textarea>
                </div>
                <div id="txtarea-cn" class="col l12">
                    <textarea name="textarea" class="jqte-test"></textarea>
                </div>
                <div id="txtarea-tw" class="col l12">
                    <textarea name="textarea" class="jqte-test"></textarea>
                </div>
                <div id="txtarea-ja" class="col l12">
                    <textarea name="textarea" class="jqte-test"></textarea>
                </div>
                <div id="txtarea-ko" class="col l12">
                    <textarea name="textarea" class="jqte-test"></textarea>
                </div>
                <div id="txtarea-th" class="col l12">
                    <textarea name="textarea" class="jqte-test"></textarea>
                </div>
                <div id="txtarea-vi" class="col l12">
                    <textarea name="textarea" class="jqte-test"></textarea>
                </div>
            </div>
            <div class="col s6 border-left">
                <div class="col s6">
                    <input type="checkbox" id="Announcement-Popup" />
                    <label for="Announcement-Popup">@AnnouncementResources.AnnouncementPopup</label>
                </div>
                <div class="col s6">
                    <input type="checkbox" id="Header-Popup" />
                    <label for="Header-Popup">@AnnouncementResources.HeaderPopup</label>
                </div>
                <div class="col s12" style="margin-top: 10px;">
                    <div class="input-field col s6">
                        <div class="lbl-field width-60">
                            @*@Html.LabelFor(from, ViewResource.From, new { @class = "active" })*@
                            <label class="active">From</label>
                        </div>
                        <div class="calendar">
                            <input type="text" name="FromDate" id="FromDate" class="datepicker" value="@DateTime.Now.AddDays(-7).ToString("MMM dd,yyyy")" />
                        </div>
                    </div>
                    <div class="input-field col s6">
                        <div class="lbl-field width-40">
                            @*@Html.LabelFor(m => m.To, ViewResource.To, new { @class = "active" })*@
                            <label class="active">To</label>
                        </div>
                        <div class="calendar">
                            <input type="text" name="ToDate" id="ToDate" class="datepicker" value="@DateTime.Now.ToString("MMM dd,yyyy")" />
                        </div>
                    </div>
                </div>
                <div class="col s12" style="margin-top: 10px;">
                    <div class="input-field col s6">
                        <select>
                            <option value="" disabled selected>Choose your option</option>
                            <option value="1"> 1</option>
                            <option value="2"> 2</option>
                            <option value="3"> 3</option>
                        </select>
                        <label>Order</label>
                    </div>
                </div>

                <div class="col s12" style="margin-top: 10px;">
                    <div class="col s12"><label>@AnnouncementResources.Environments</label></div>
                   @foreach (var environment in AppSettings.AnnouncementConfig.Environments)
                   {
                        <div class="col s2">
                            <input type="checkbox" id="@environment" />
                            <label for="@environment">@environment</label>
                        </div>
                    }

                </div>

                <div class="col s12" style="margin-top: 10px;">
                    <div class="s12"><label>@AnnouncementResources.Sysmtems</label></div>
                  @foreach (var system in AppSettings.AnnouncementConfig.Sites)
                  {
                        <div class="col s2">
                            <input type="checkbox" id="@system" />
                            <label for="@system">@system</label>
                        </div>
                    }

                </div>
                <div class="col s12" style="margin-top: 100px;">
                    <div class="col s2"><input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" name="btnNext" id="btnNext" value="@AnnouncementResources.Next" /></div>
                    <div class="col s10"><input class="btn btn-info  waves-effect waves-light btn btn-primary" type="button" name="btnSave" id="btnSave" value="@AnnouncementResources.Save" /></div>
                </div>
            </div>
        </div>
    </div>
    </form>


    <script type="text/javascript" src="http://code.jquery.com/jquery.min.js" charset="utf-8"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/0.97.6/js/materialize.min.js"></script>

    @Scripts.Render("~/Assets/scripts/lib/jQuery-TE.1.4.0/jquery-te-1.4.0.min.js")
    @Scripts.Render("~/Assets/scripts/lib/Momentjs/moment.min.js")
    @Scripts.Render("~/Assets/scripts/lib/Select2/select2.js")
    @Scripts.Render("~/scripts/common")

  @Scripts.Render("~/Assets/scripts/Announcement/compose-messages.js")