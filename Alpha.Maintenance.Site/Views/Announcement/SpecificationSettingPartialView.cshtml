@model ComposeAnnouncementViewModel

<div id="specs-setting" class="hiden specs-setting">
    <div class="row title">
        <div class="col s1">
            &nbsp;
        </div>
        <div class="col s3">
            @AnnouncementResources.Specification
        </div>
        <div class="col s7">
            @AnnouncementResources.Value
        </div>
        <div class="col s1">
            Delete
        </div>
    </div>

    @*<div class="row">
            <div class="col s1"> &nbsp;</div>
            <div class="divider col s8"></div>
        </div>*@

    @foreach (var specification in Model.Announcement.Specifications)
    {
        @RenderSpecification(specification);
    }

    @foreach (var specification in Model.NotExistedSpecifications)
    {
        @RenderSpecification(specification, false);
    }

    <div class="row add-rules @(Model.NotExistedSpecifications.Count().Equals(0)? "hiden" : string.Empty)" id="div-choose-specification">
        @*<div class="col s2">
                &nbsp;
            </div>*@
        <div class="col s2">
            <select id="dll-choose-specification" name="dll-choose-specification">
                <option value="" disabled selected">@AnnouncementResources.AddSpecification</option>
                @foreach (var specification in Model.NotExistedSpecifications)
                {
                    <option value="@specification.Id">@specification.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="row">
        <div class="button-group">
            <a class="btn btn-info waves-effect waves-light btn btn-primary btnPrev">@AnnouncementResources.Prev</a>
            <a class="btn btn-info waves-effect waves-light btn btn-primary btnSave">@AnnouncementResources.Save</a>
            @if (Model.ActionType.Equals(ActionType.Update))
            {
                <a class="btn btn-info waves-effect waves-light btn btn-outline btnCopy">@AnnouncementResources.MakeACopy</a>
            }

            <input type="hidden" id="number-of-specifications" value="@(Model.NotExistedSpecifications.Count() + Model.Announcement.Specifications.Count())">
        </div>
    </div>
</div>

@helper RenderSpecification(ISpecification<IParam> specification, bool isShowSpec = true)
{
var txtSpecsDictionary = new List<Type>()
        {
            typeof(SiteSpecification),
            typeof(UserIdSpecification),
            typeof(CurrencySpecification),
            typeof(ProductSpecification),
            typeof(UplineIdsSpecification)
        };


    <div data-jsonobject="@JsonConvert.SerializeObject(specification)" class="row data-rules @(isShowSpec ? string.Empty : "hiden")" name="div-specification" id="@specification.Id">
        <div class="col s1">
            <span class="text" id="dll-specification-conjunctionOperator">
                @ConjunctionOperator.And
            </span>
            &nbsp;
        </div>
        <div class="col s3">
            <span class="text">@specification.Name</span>
        </div>
        <div class="col s7 values-block">
            <div class="operator">
                @if (specification.GetType() == typeof(SyncedRnGCasinoSpecification) || specification.GetType() == typeof(EnableYesterdayTransferSpecification))
                {
                    var checkedStatus = (specification.Value == null || !specification.Value) ? string.Empty : "checked";                   

                    <div class="checkbox">
                        <input type="checkbox" class="toogle" id="@specification.GetType()" @checkedStatus />
                        <label for="@specification.GetType()"><span></span>&nbsp;</label>
                    </div>
                }
                else if (specification.GetType() == typeof(UnsynchronizedSettingSpecification))
                {
                    <div>&nbsp;</div>
                }
                else
                {
                    @Html.EnumDropDownList("dll-specification-specificationOperator", specification.SpecificationOperator,
                            new Dictionary<string, object>() { { "data-parentId", specification.Id }, { "class", "specification-operator" } })
                }
            </div>
            @if (specification.GetType() == typeof(UserLevelSpecification))
            {
                @RenderSpecDll(specification, isShowSpec);
            }

            else if (txtSpecsDictionary.Contains(specification.GetType()))
            {
                @RenderSpecTxt(specification, isShowSpec);
            }

            else
            {
                @RenderCustomSpec();
            }
        </div>
        <div class="col s1 hidden-specification link" data-id="@specification.Id" data-name="@specification.Name">
            <a class="tooltipped icon-bin text" data-tooltip="@AnnouncementResources.DeleteSpecification"></a>
        </div>
    </div>
}

@helper RenderSpecDll(ISpecification<IParam> specification, bool isShowSpec)
{
if (specification.Value == null && specification.GetType() == typeof(UserLevelSpecification))
{
    specification = new UserLevelSpecification(new List<byte> { 2 });
}
    <div class="input-field values-input">
        <select id="dll-specification-value" name="dll-specification-value" multiple data-specificationId="@specification.Id">
            @foreach (var userLevel in Model.UserLevels)
            {
                var selected = specification.Value.Contains((byte)userLevel.Id) ? "selected" : string.Empty;
                <option value="@userLevel.Id" @selected>@userLevel.Name</option>
            }
        </select>
    </div>
}

@helper RenderSpecTxt(ISpecification<IParam> specification, bool isShowSpec)
{
    <div class="input-field values-input">
        <input type="text" id="txt-specification-value"
               name="txt-specification-value"
               placeholder="@AnnouncementResources.InputValue"
               value="@(isShowSpec ? string.Join(",", specification.Value?? string.Empty) : string.Empty)"
               data-specificationId="@specification.Id" />
    </div>
}

@helper RenderCustomSpec()
{
    <div>&nbsp;</div>
}
