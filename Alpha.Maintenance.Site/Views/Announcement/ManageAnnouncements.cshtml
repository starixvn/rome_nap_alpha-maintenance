@model ManageAnnouncementsViewModel

@{
    ViewBag.Title = "Messages & Announcements Management Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    @Styles.Render("~/css/select2")
}

@section Headline {
    <span>@AnnouncementResources.Announcement / </span>
    <span class="active">@AnnouncementResources.ManageAnnouncements</span>
}

<form role="form" id="report-form" action="@Url.Action("ManageAnnouncements", "Announcement")">
    <section id="filter-bar">
        <div class="filter-form row">
            <div class="input-field col s2">
                <div class="lbl-field">
                    @Html.LabelFor(m => m.FromDate, ViewResource.From, new { @class = "active" })
                </div>
                <div class="calendar">
                    <input type="text" name="FromDate" id="FromDate" class="datepicker" value="@Model.FromDate.ToString("MMM dd,yyyy")" />
                </div>
            </div>
            <div class="input-field col s2">
                <div class="lbl-field">
                    @Html.LabelFor(m => m.ToDate, ViewResource.To, new { @class = "active" })
                </div>
                <div class="calendar">
                    <input type="text" name="ToDate" id="ToDate" class="datepicker" value="@Model.ToDate.ToString("MMM dd,yyyy")" />
                </div>
            </div>
            <div class="col s2">
                <div class="input-field">
                    <select name="Environment" id="Environment">
                        <option value="">@AnnouncementResources.All</option>
                        @foreach (var environment in AppSettings.AnnouncementConfig.Environments)
                        {
                            <option value="@environment" @(environment.Equals(Model.Environment) ? "selected" : string.Empty)>@environment</option>
                        }
                    </select>
                    <label class="margin-left-minus15px">@AnnouncementResources.Environments</label>
                </div>
            </div>
            <div class="col s2">
                <div class="input-field">
                    <select name="System" id="System">
                        <option value="">@AnnouncementResources.All</option>
                        @foreach (var system in AppSettings.AnnouncementConfig.Systems)
                        {
                            <option value="@system" @(system.Equals(Model.System) ? "selected" : string.Empty)>@system</option>
                        }
                    </select>
                    <label class="margin-left-minus15px">@AnnouncementResources.Sysmtems</label>
                </div>
            </div>
            <div class="col button-block">
                <input class="waves-effect waves-light btn btn-primary" type="submit" value="@ViewResource.Submit" id="submit" />
                <a href="@Url.Action("ComposeMessage", "Announcement")">
                    <input class="waves-effect waves-light btn btn-create" type="button" value="@AnnouncementResources.Add" id="add" />
                </a>
            </div>
        </div>
    </section>
</form>

<div class="table">
    <table class="grid persist-area" id="messageContainer">
        <thead class="persist-header">
            <tr>
                <th>
                    @AnnouncementResources.Title
                </th>
                <th>
                    @AnnouncementResources.Code
                </th>
                <th>
                    @AnnouncementResources.Priority
                </th>
                <th>
                    @AnnouncementResources.Active
                </th>
                <th>
                    @AnnouncementResources.FromDate
                </th>
                <th>
                    @AnnouncementResources.ToDate
                </th>
                <th>
                    @AnnouncementResources.Environments
                </th>
                <th>
                    @AnnouncementResources.Sysmtems
                </th> 
                <th>
                    @AnnouncementResources.Type
                </th>
            </tr>
        </thead>
        <tbody id="content">
            @if (Model.Announcements.Any())
            {
                foreach (var announcement in Model.Announcements)
                {
                    <tr>
                        <td>
                            <a href="@Url.Action("ComposeMessage", "Announcement", new { Id = announcement.Id })"
                               class="tooltipped"
                               data-tooltip="@AnnouncementResources.Edit">
                                @announcement.Title
                            </a>
                        </td>
                        <td>
                            @announcement.Code
                        </td>
                        <td>
                            @announcement.Ordinal
                        </td>
                        <td>
                            <input type="checkbox" id="@announcement.Id" checked="@announcement.IsActive" disabled />
                            <label for="@announcement.Id"><!--c--></label>
                        </td>
                        <td>
                            @announcement.FromDate.ToShortDateString()
                        </td>
                        <td>
                            @announcement.ToDate.ToShortDateString()
                        </td>
                        <td>
                            @String.Join(", ", announcement.Environments.ToArray())
                        </td>
                        <td>
                            @String.Join(", ", announcement.Systems.ToArray())
                        </td>
                        <td>
                            @announcement.AnnouncementType
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="no-data">@AnnouncementResources.NoInformation</td>
                </tr>
            }

        </tbody>
    </table>
</div>

@section Foot {
    @Scripts.Render("~/Assets/bundles/manage-announcements.js")
}
