@model AnnouncementViewModel

@{
    ViewBag.Title = "Messages & Announcements Management Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    @Styles.Render("~/css/select2")
}

@section Headline {
    <span>@AnnouncementResources.Announcement / </span>
    <span class="active">@AnnouncementResources.ShowAll</span>
}

<form role="form" id="report-form" action="@Url.Action("ShowAnnouncements", "Announcement")">
    <section id="filter-bar">
        <div class="filter-form">
            <div class="row">
                <div class="col l12">
                    <div class="input-field col l3">
                        <div class="lbl-field width-60">
                            @Html.LabelFor(m => m.FromDate, ViewResource.From, new { @class = "active" })
                        </div>
                        <div class="calendar">
                            <input type="text" name="FromDate" id="From" class="datepicker" value="@Model.FromDate.ToString("MMM dd,yyyy")" />
                        </div>
                    </div>
                    <div class="input-field col l3">
                        <div class="lbl-field width-40">
                            @Html.LabelFor(m => m.ToDate, ViewResource.To, new { @class = "active" })
                        </div>
                        <div class="calendar">
                            <input type="text" name="ToDate" id="To" class="datepicker" value="@Model.ToDate.ToString("MMM dd,yyyy")" />
                        </div>
                    </div>
                    <div class="col s3">
                        <div class="input-field col l6">
                            <select name="Environment" id="Environment">
                                <option value="">@AnnouncementResources.All</option>
                                @foreach (var environment in AppSettings.AnnouncementConfig.Environments)
                                {
                                    <option value="@environment" @(environment.Equals(Model.Environment) ? "selected" : string.Empty)>@environment</option>
                                }
                            </select>
                            <label>@AnnouncementResources.Environments</label> 
                        </div>
                    </div>
                    <div class="col button-block">
                        <input class="waves-effect waves-light btn btn-primary" type="submit" value="@ViewResource.Submit" id="submit" />
                        <a href="@Url.Action("ComposeMessage", "Announcement")">
                            <input class="waves-effect waves-light btn btn-primary" type="button" value="@AnnouncementResources.Add" id="add" />
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    </form>

    <div class="table">
        <table class="grid persist-area" id="messageContainer">
            <thead class="persist-header">
                <tr>
                    <th>
                        @AnnouncementResources.Code
                    </th>
                    <th>
                        @AnnouncementResources.Title
                    </th>
                    <th>
                        @AnnouncementResources.Edit
                    </th>
                    <th>
                        @AnnouncementResources.Type
                    </th>
                    <th>
                        @AnnouncementResources.Environments
                    </th>
                    <th>
                        @AnnouncementResources.Sysmtems
                    </th>
                    <th>
                        @AnnouncementResources.Active
                    </th>
                    <th>
                       @AnnouncementResources.Priority
                    </th>
                    <th>
                        @AnnouncementResources.FromDate
                    </th>
                    <th>
                        @AnnouncementResources.ToDate
                    </th>
                </tr>
            </thead>
            <tbody id="content">
                @foreach (var announcement in Model.Announcements)
                {
                <tr>
                    <td>
                        @announcement.Code
                    </td>
                    <td>
                        @announcement.Title
                    </td>
                    <td>
                        <a href="">
                            Edit
                        </a>
                    </td>
                    <td>
                        @announcement.AnnouncementType
                    </td>
                    <td>
                        @String.Join(", ", announcement.Environments.ToArray())
                    </td>
                    <td>
                        @String.Join(", ", announcement.Systems.ToArray())
                    </td>
                    <td>
                        <input type="checkbox" id="@announcement.Id" checked="@announcement.IsActive" />
                        <label for="@announcement.Id"><!--c--></label>
                    </td>
                    <td>
                        @announcement.Order
                    </td>
                    <td>
                        @announcement.FromDate.ToShortDateString()
                    </td>
                    <td>
                        @announcement.ToDate.ToShortDateString()
                    </td>
                </tr>
                }

            </tbody>
        </table>
    </div>

@section Foot {
    @Scripts.Render("~/scripts/show-announcement")
}
