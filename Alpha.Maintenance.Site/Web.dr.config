  <system.web>
    <compilation debug="false" targetFramework="4.0" />
    <authentication mode="Forms">
      <forms name=".DWASPXAUTH" ticketCompatibilityMode="Framework40" loginUrl="~/Auth" timeout="2880" defaultUrl="~/Home" cookieless="UseCookies" ></forms>
    </authentication>
    <customErrors mode="RemoteOnly" defaultRedirect="~/Auth/Error" />
    <sessionState mode="StateServer" timeout="10" stateConnectionString="tcpip=10.143.8.100:42424" />
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
