  </NapSettings>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider,Fanex.Data" resourcePath="~/App_Data/DR/" enableWatching="1" ignoreExceptionIsNotParameters="1" />
