<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <configSections>
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core.Client" />
    <sectionGroup name="bundleTransformer">
      <section name="core" type="BundleTransformer.Core.Configuration.CoreSettings, BundleTransformer.Core" />
    </sectionGroup>
    <section name="Fanex.MailDelivery.Admin" type="Fanex.MailDelivery.Admin.Configurations.MailAdminSection, Fanex.MailDelivery.Admin" />
    <section name="couchbase" type="Couchbase.Configuration.CouchbaseClientSection, Couchbase" />
  </configSections>
  <couchbase>
    <servers bucket="Alpha" bucketPassword="">
      <add uri="http://10.2.12.6:8091/pools/default"/>
    </servers>
  </couchbase>

  <NapSettings
    Environment="LIVE"
    EnableDirectLogin="1"
    SiteId="26"   
    EnableReCheckin="true"
    HubUrl="http://nap-hub.ibcbk.com/"
    UnauthorizeUrl="~/UserLogin/Common/Unauthorize"
      ServiceUrls="http://10.40.40.202:1710/api"
      AccessKey="SPTTPoMu8+hvOZeNu7E4ykjWqgiIU7TNYocgyFVyp+A=">
    <Domain>
      <add Name="msite.ibcbk.com" Path="/"></add>
    </Domain>
  </NapSettings>
  
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider,Fanex.Data" resourcePath="~/App_Data/PRO/" enableWatching="1" ignoreExceptionIsNotParameters="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.2.98.3\private$\entlib" defaultCategory="mSite" />
  <connectionStrings configSource="WebConnectionString.config"></connectionStrings>
  <Fanex.MailDelivery.Admin rabbitMQConnectionString="host=10.40.40.202;virtualHost=/MailStationHost;username=rabbitclient"  />
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="app_mail_id" value="1" />
    <add key="app_mail_address" value="net.tcp://10.40.40.202:8585/MailService"/>
    <add key="CSDUserIds" value="352361,352362,13771383"/>
    <add key="GMTShowLog" value="-4"/>
    <add key="MailPermission:Application" value="ViewAccountingReportMail:1;ViewAccountingServiceReportMail:16;ViewNAPSpecialDeleteMail:22"/>
    <add key="Announcement:ConfigFilePath" value="~/App_Data/announcementConfig.json" />

    <add key="api.ipstack.com:ApiUrl" value="http://api.ipstack.com/?access_key=cec73693b62338e96650ed79f7eb95b9"/>
    <add key="api.ipstack.com:WebUrl" value="http://api.ipstack.com/?access_key=cec73693b62338e96650ed79f7eb95b9&amp;format=1"/>
    <add key="api.ipstack.com:CountryCodeKey" value="country_code"/>
    <add key="api.ipstack.com:CountryNameKey" value="country_name"/>
    <add key="api.ipstack.com:RegionKey" value="region_name"/>
    <add key="api.ipstack.com:CityKey" value="city"/>

    <add key="ip-api.com:ApiUrl" value="http://ip-api.com/json/"/>
    <add key="ip-api.com:WebUrl" value="http://ip-api.com/#"/>
    <add key="ip-api.com:CountryCodeKey" value="countryCode"/>
    <add key="ip-api.com:CountryNameKey" value="country"/>
    <add key="ip-api.com:RegionKey" value="regionName"/>
    <add key="ip-api.com:CityKey" value="city"/>

    <add key="eXTReMe-IP-Lookup.com:ApiUrl" value="https://extreme-ip-lookup.com/json/"/>
    <add key="eXTReMe-IP-Lookup.com:WebUrl" value="https://extreme-ip-lookup.com/"/>
    <add key="eXTReMe-IP-Lookup.com:CountryCodeKey" value="countryCode"/>
    <add key="eXTReMe-IP-Lookup.com:CountryNameKey" value="country"/>
    <add key="eXTReMe-IP-Lookup.com:RegionKey" value="region"/>
    <add key="eXTReMe-IP-Lookup.com:CityKey" value="city"/>

    <add key="banner:Environments" value="UAT,Staging,PRO" />
    <add key="banner:Sites" value="IBCBET,789Y,IBCIndo" />
    <add key="banner:LanguageCodes" value="en-US,vi-VN,zh-CN,zh-TW,th-TH,ko-KR,ja-JP" />
    <add key="RedisConfigurationOptions:Alpha.Before" value="localhost:6379,Name=Alpha.Before.MNL,AbortConnect=false" />

    <!--ONEbook.UM-->
    <add key="ONEbook.UM:ServiceUri" value="http://10.40.40.202:8889/api" />
    <add key="ONEbook.UM:EnableCheckUM" value="false" />
    <add key="ONEbook.UM:SiteId" value="2000000" />
    <add key="ONEbook.UM:EnableUnscheduledUM" value="false" />
    <add key="ONEbook.UM:UMFrom" value="3:00" />
    <add key="ONEbook.UM:UMTo" value="4:00" />
    <add key="ONEbook.UM:UMPageUrl" value="~/UserLogin/Common/Offline" />
    <add key="ONEbook.UM:ResultCacheDuration" value="60" />
    <!--<add key="ONEbook.UM:UMLoggingCategory" value="ONEbook-UM" />
    <add key="ONEbook.UM:ErrorUMPageUrl" value="" />-->
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.0" />
    <authentication mode="Forms">
      <forms ticketCompatibilityMode="Framework40" loginUrl="~/UserLogin/Login" timeout="2880" defaultUrl="~/Home" cookieless="UseCookies" ></forms>
    </authentication>
    <customErrors mode="Off" defaultRedirect="~/UserLogin/Common/Error/">
      <error statusCode="403" redirect="~/UserLogin/Common/Unauthorize" />
      <error statusCode="404" redirect="~/UserLogin/Common/NotFound/" />
    </customErrors>
    <sessionState mode="StateServer" cookieless="false" timeout="20000" />
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
    <httpHandlers>
      <add path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler, dotless.Core" />
    </httpHandlers>
    <machineKey validationKey="82DD5F7E8AEE17163191F82D6E74F88716B3A834BD6D1DC5F32CB2F613222E36144B019843C69D711C8EE551F341FDFD60B1AB77F943B02A00467A0D2D632EEB"
      decryptionKey="436E102A02B3582E206F1111DC137F5F2BFC57EBFB8ECD6736596ABDA63B9A65"
      validation="SHA1" decryption="AES" />
  </system.web>
  <system.web.extensions>
    <scripting>
      <webServices>
        <jsonSerialization maxJsonLength="10485760"></jsonSerialization>
      </webServices>
    </scripting>
  </system.web.extensions>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-ISAPI-4.0_32bit" />
      <remove name="ExtensionlessUrlHandler-ISAPI-4.0_64bit" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="ExtensionlessUrlHandler-ISAPI-4.0_32bit" path="*." verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTIONS" modules="IsapiModule" scriptProcessor="%windir%\Microsoft.NET\Framework\v4.0.30319\aspnet_isapi.dll" preCondition="classicMode,runtimeVersionv4.0,bitness32" responseBufferLimit="0" />
      <add name="ExtensionlessUrlHandler-ISAPI-4.0_64bit" path="*." verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTIONS" modules="IsapiModule" scriptProcessor="%windir%\Microsoft.NET\Framework64\v4.0.30319\aspnet_isapi.dll" preCondition="classicMode,runtimeVersionv4.0,bitness64" responseBufferLimit="0" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTIONS" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
      <add name="dotless" path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler,dotless.Core" resourceType="File" preCondition="" />
    </handlers>
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/x-font-woff" />
    </staticContent>
  </system.webServer>
  <dotless minifyCss="false" cache="true" web="false" />
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
