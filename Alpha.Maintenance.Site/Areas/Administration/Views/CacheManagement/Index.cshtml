@using Alpha.Maintenance.Repository.Criteria.Log

@model GetLogCriteria

@{
    ViewBag.Title = "Cache Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {

}

<div class="filter-form">
    <div class="row">
        <div id="error-message" class="card-panel lighten-4 text-darken-4 red red-text hiden"></div>
    </div>
    <div class="row">
        <div class="input-field col l2">
            <select name="pattern" id="pattern">
                <option value="1">Agent Multiple Transfer</option>
                <option value="2">Login Blocked IP</option>
            </select>
            <label class="active">Pattern</label>
        </div>
        <div class="input-field col l2">
            <select name="pattern" id="siteGroup">
                <option value="IBCBET">IBCBET</option>
                <option value="IBCIndo">IBCIndo</option>
                <option value="789Y">789Y</option>
            </select>
            <label class="active">SiteGroup</label>
        </div>
        <div class="input-field col l2">
            <input type="text" id="keys" name="keys" value="" />
            <label class="active">Keys</label>
        </div>
        <div class="col button-block">
            <a id="submit" class="waves-effect waves-light btn btn-primary"><input type="submit" value="Get" /></a>
            <input class="waves-effect btn btn-outline" id="del-document" type="button" value="Clear" />
        </div>
    </div>
    <div class="row ">
        <div class="table">
            <table id="result-table" class="grid">
                <thead>
                    <tr>
                        <th class="center l1">Cache Key</th>
                        <th class="center">Cache Value</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>
@section Headline {
    <span>Admin Tools / </span>
    <span class="active">@ViewBag.Title</span>
}

@section Foot {
    @Scripts.Render("~/Assets/bundles/Administration/CacheManagement.js?v=1.0.0")
}
