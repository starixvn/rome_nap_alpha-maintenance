@{
    Layout = null;
}
@model List<Alpha.Maintenance.Core.Model.DbProfilerViewModel>

@if (Model.Any())
{
    foreach (var item in Model)
    {
        <tr>
            <td>@item.Event</td>
            <td>@item.SPID</td>
            <td>@Html.Raw(Html.Encode(item.TextData))</td>
            <td>@item.LoginName</td>
            <td>@item.DatabaseName</td>
            <td>@item.Reads</td>
            <td>@item.Writes</td>
            <td>@item.CPU</td>
            <td>@item.Duration</td>
            <td>@item.StartTime</td>
            <td>@item.EndTime</td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="11">There is no data...</td>
    </tr>
}

