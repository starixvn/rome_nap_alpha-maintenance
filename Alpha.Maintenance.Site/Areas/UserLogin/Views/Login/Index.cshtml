<html lang="en">
<!--<![endif]-->
<head>
    <meta charset="utf-8" />
    <title>@ViewResources.Log_In</title>
    <meta name="viewport" content="width=device-width" />
    <link href='https://fonts.googleapis.com/css?family=Roboto' rel='stylesheet' type='text/css'>
    <link href="~/Areas/UserLogin/themes/loginNew.css" rel="stylesheet" />
    <link href="~/Areas/UserLogin/scripts/lib/msgbox/msgbox-0.0.1.css" rel="stylesheet"
          type="text/css" />
</head>
<body>
    <div id='not-supported-browser-panel' style="display: none">
        Your browser is no longer supported. Some parts will not work and you may experience
        problems.<br />
        If you are having problems, try <a href='http://browsehappy.com/'>this</a> for full
        browsing experience. Thank you!
    </div>
    @using (Html.BeginForm())
    {
        <div id="login-box">
            <div id="msg">
                <span id="inner-msg"></span>
            </div>
            <div class="header">
                <div class="welcome">
                    <img src="~/Areas/UserLogin/themes/img/m7_logo.png" width="87" height="44" />
                </div>
            </div>
            <div class="auth">
                <div class="userName js-effect">
                    <input class="validate" type="text" id="username" name="username" autocomplete="off" />
                    <label class="lb" for="username">User name</label>
                </div>
                <div class="password js-effect">
                    <input class="validate" type="password" id="password" name="password" readonly onfocus="$(this).removeAttr('readonly');" autocomplete="off" />
                    <label class="lb" for="password">Password</label>
                </div>
                <a class="btn-login waves-effect waves-light btn">
                    <input type="submit" id="submit" value="@ViewResources.Log_In" />
                </a>
            </div>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Message))
                {
                <div class="secure"></div>
                <div class="msg-content" id="msg-content">
                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="24" height="24" viewBox="0 0 24 24"><path fill="#fed720" d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z" /></svg>
                    <span id="inner-msg">@ViewBag.Message</span>
                </div>
            }
        </div>
    }
</body>
</html>
<script src="~/Areas/UserLogin/scripts/lib/jquery-1.8.0.min.js"
        type="text/javascript"></script>
<script src="~/Areas/UserLogin/scripts/lib/msgbox/msgbox-0.0.1.js" type="text/javascript"></script>
<script src="~/Assets/scripts/Login/index.js"></script>
