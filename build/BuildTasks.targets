<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         DefaultTargets="MyTargets"
         InitialTargets="MyTargets">
  <UsingTask AssemblyFile="WebCompiler\WebCompiler.exe" TaskName="WebCompiler.CompilerBuildTask"/>
  <UsingTask AssemblyFile="WebCompiler\WebCompiler.exe" TaskName="WebCompiler.CompilerCleanTask"/>
  <UsingTask AssemblyFile="BundlerMinifier\BundlerMinifier.exe" TaskName="BundlerMinifier.BundlerBuildTask"/>
  <UsingTask AssemblyFile="BundlerMinifier\BundlerMinifier.exe" TaskName="BundlerMinifier.BundlerCleanTask"/>

  <Target Name="MyTargets">
    <WebCompiler.CompilerCleanTask FileName="$(MSBuildProjectDirectory)\..\Alpha.Maintenance.Site\compilerconfig.json" />
    <WebCompiler.CompilerBuildTask FileName="$(MSBuildProjectDirectory)\..\Alpha.Maintenance.Site\compilerconfig.json" />
	<BundlerMinifier.BundlerCleanTask FileName="$(MSBuildProjectDirectory)\..\Alpha.Maintenance.Site\bundleconfig.json" />
	<BundlerMinifier.BundlerBuildTask FileName="$(MSBuildProjectDirectory)\..\Alpha.Maintenance.Site\bundleconfig.json" />
  </Target>
  
</Project>
